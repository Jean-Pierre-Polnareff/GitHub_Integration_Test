<property id="1058" name="ArchiveFileNamingConvention" dataType="System.String" state="default" isArray="false" description="File naming convention for archived file. By default it will same name as original source file processed. But you can control naming format using {%name%} and {%ext%} placeholders. e.g. {%name%}_processed{%ext%} or {%name%}{%ext%}.{{System::ContainerStartTime,yyyyMMdd_HHmmss_fff}}" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
