<property id="1088" name="ArrayTransformationType" dataType="System.Int32" state="default" isArray="false" description="Array Transformation you want to apply. Useful for case when you have 2-Dimensional arrays with rows/columns in separate arrays." typeConverter="ZappySys.Json.ArrayTransformType, ZappySys.Json, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
