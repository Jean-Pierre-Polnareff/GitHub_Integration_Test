<property id="1090" name="ArrayTransRowValueFilter" dataType="System.String" state="default" isArray="false" description="Filter expression for row values (Not applicable for simple array transformation)." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1091" name="ArrayTransEnableCustomColumns" dataType="System.Boolean" state="default" isArray="false" description="When you have 2D array but don't have column list specified in a separate array then use this option (e.g. { arr: [[10,11],[21,22]] } )." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1092" name="ArrayTransCustomColumns" dataType="System.String" state="default" isArray="false" description="When you have 2D array but don't have column list specified in a separate array then use specify column names here. Use comma separated list (e.g col1,col2,col3 ). Column name Order must match value order." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property></properties>
