<property id="1069" name="ResponseErrorString" dataType="System.String" state="default" isArray="false" description="Expected error message sub string from response." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">not found</property>
<property id="1070" name="ResponseStatusCode" dataType="System.Int32" state="default" isArray="false" description="Expected status code from response when page number you trying to access not found." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">404</property>
