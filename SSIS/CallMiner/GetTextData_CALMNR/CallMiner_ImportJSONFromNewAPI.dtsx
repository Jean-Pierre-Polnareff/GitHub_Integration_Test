<property id="1060" name="EnablePivot" dataType="System.Boolean" state="default" isArray="false" description="When this property is true then Column is converted to Row. Pivoted names will appear under  Pivot_Name column and values will appear under Pivot_Value field." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1061" name="PagingMode" dataType="System.Int32" state="default" isArray="false" description="Specified how you want to loop through multiple pages returned by REST API." typeConverter="ZappySys.Common.RestApiPagingMode, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1062" name="PageNumberAttributeNameInUrl" dataType="System.String" state="default" isArray="false" description="e.g. Type page_num if URL looks like this =&gt; http://abc.com/?page_num=1&amp;sort=true  (page number via query string)&#xA;--or-- Type &lt;%page%&gt; if page number is inside URL path like this =&gt; http://abc.com/1/?sort=true  (e.g. replace page number in url with placeholder http://abc.com/&lt;%page%&gt;/?sort=true)&#xA;Page number will be incremented by one for next URL until last page is reached or [Max Page Number] is reached" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1063" name="MaxPageNumber" dataType="System.Int32" state="default" isArray="false" description="Maximum page number until which auto increment is allowed. Type zero for no limit. Next URL contains next page number (increment by one) until last page is detected or [Max Page Number] limit is reached." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1064" name="StartPageNumberVariable" dataType="System.String" state="default" isArray="false" description="Variable name which will hold starting page number. This is ignored if you useing parameter name from query string to indicate page number." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1065" name="PagingEndStrategy" dataType="System.Int32" state="default" isArray="false" description="Specified how you want detect last page." typeConverter="ZappySys.Common.UrlPagingEndDetectionStrategy, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1066" name="LastPageWhenConditionEqualsTo" dataType="System.Boolean" state="default" isArray="false" description="Condition result to compare to detect last page. Set this property to True if you want detect last page if condition is true else set this to False." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
