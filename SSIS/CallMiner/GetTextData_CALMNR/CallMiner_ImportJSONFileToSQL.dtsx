<property id="30" name="NextUrlWait" dataType="System.Int32" state="default" isArray="false" description="This property indicates total number of milliseconds you want to wait before sending next request. This option allows you to adjust how many API calls can be made within certain timeframe. If your API Service has no limit then set this option to zero" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="31" name="ContinueOnUrlNotFoundError" dataType="System.Boolean" state="default" isArray="false" description="If this option is true then component will continue without exception on 404 error (Url not found). This allows you to consume data gracefully." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="32" name="CookieContainerVariable" dataType="System.String" state="default" isArray="false" description="Cookie Container can be used to maintain state between multiple web requests. Example: You can login to site like wordpress and then extract any private page content by simply passing authentication cookies using this variable." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="33" name="Filter" dataType="System.String" state="default" isArray="false" description="Enter expression here to filter data.(Example:  $.Users[*].UserName ) This will fetch User names from users records" typeConverter="" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" containsID="false" expressionType="Notify"></property>
<property id="34" name="IncludeParentColumns" dataType="System.Boolean" state="default" isArray="false" description="Use this option to include parent properties (Non array) in the output along with Filtered Rows" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="35" name="IncludeParentColumnsWithArrayType" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to output parent columns which are array. By default any parent column which is an array is not included in output. See also FilterForParentColumnsWithArrayType property if you set this property" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="36" name="FilterForParentColumnsWithArrayType" dataType="System.String" state="default" isArray="false" description="Set this option to true if you want to output parent columns which are array. By default any parent column which is an array is not included in output. See also FilterForParentColumnsWithArrayType property if you set this property" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="37" name="ParentColumnPrefix" dataType="System.String" state="default" isArray="false" description="Prefix for parent column name. This option is only valid if you have set IncludeParentColumns=True" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">P_</property>
<property id="38" name="ThrowErrorIfPropertyMissing" dataType="System.Boolean" state="default" isArray="false" description="Throw error if property name specified in filter expression is missing. By default it will ignore any missing property errors." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="39" name="MaxLevelsToScan" dataType="System.Int32" state="default" isArray="false" description="This property how many nested levels should be scanned to fetch various properties. 0=Scan all child levels." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="40" name="ExcludedProperties" dataType="System.String" state="default" isArray="false" description="List comma separated property names from JSON document which you want to exclude from output. Specify parent property name to exclude all child nodes." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="41" name="RequestTimeout" dataType="System.Int32" state="default" isArray="false" description="Http request Timeout in seconds. Set this to 0 if you want to use system default value (i.e. 100 seconds)" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="42" name="SecurityProtocol" dataType="System.Int32" state="default" isArray="false" description="Specifies which security protocol is supported for HTTPS communication. Using this option you can enable legacy protocol or enforce to use latest version of security protocol (Note: TLS 1.2 is only supported in SSIS 2014 or Higher)." typeConverter="ZappySys.PowerPack.Common.HttpsSecurityProtocolType, ZappySys.PowerPack100, Version=1.0.0.0, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="43" name="EnableCompressionSupport" dataType="System.Boolean" state="default" isArray="false" description="Enable support for gzip or deflate compression. When you check this option compressed response automatically de-compressed saving bandwidth. This option is only valid if web server supports compressed response stream. Check your API documentation for more information." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="44" name="IgnoreCertificateErrors" dataType="System.Boolean" state="default" isArray="false" description="Ignore SSL certificate related errors. Example: if you getting SSL/TLS errors because of certificate expired or certificate is not from trusted authority or certificate is self-signed. By checking this option you will not get SSL/TLS error." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="45" name="DateFormatString" dataType="System.String" state="default" isArray="false" description="Specifies how custom date formatted strings are parsed when reading JSON." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="46" name="DateParseHandling" dataType="System.Int32" state="default" isArray="false" description="Specifies how date formatted strings, e.g. Date(1198908717056) and 2012-03-21T05:40Z, are parsed when reading JSON." typeConverter="ZappySys.Common.DateParseHandling, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="47" name="OutputRawDocument" dataType="System.Boolean" state="default" isArray="false" description="Output as raw JSON document rather than parsing individual fields. This option is helpful if you have documents stored in a file and you want to pass them downstream as raw JSON string rather than parsing into columns." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="48" name="IndentOutput" dataType="System.Boolean" state="default" isArray="false" description="Indent JSON output so its easy to read." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1846" name="OutputFilePath" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to output FilePath. This option is ignored when you consume DirectValue or data from Url rather than local files. Output column name will be __FilePath" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1847" name="OutputFileName" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to output FileName. This option is ignored when you consume DirectValue or data from Url rather than local files. Output column name will be __FileName" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="1848" name="EnableArchiveFile" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to move processed file to archive folder." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1849" name="ArchiveFolderPath" dataType="System.String" state="default" isArray="false" description="Folder path where you want to move processed file." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1850" name="OverwriteFileInArchiveFolder" dataType="System.Boolean" state="default" isArray="false" description="Folder path where you want to move processed file." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1851" name="ArchiveFileNamingConvention" dataType="System.String" state="default" isArray="false" description="File naming convention for archived file. By default it will same name as original source file processed. But you can control naming format using {%name%} and {%ext%} placeholders. e.g. {%name%}_processed{%ext%} or {%name%}{%ext%}.{{System::ContainerStartTime,yyyyMMdd_HHmmss_fff}}" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1852" name="UseConnection" dataType="System.Boolean" state="default" isArray="false" description="Use connection to pass credentials for authentication (e.g. Use UserID/Password or Use OAuth Protocol for token based approach)" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1853" name="EnablePivot" dataType="System.Boolean" state="default" isArray="false" description="When this property is true then Column is converted to Row. Pivoted names will appear under  Pivot_Name column and values will appear under Pivot_Value field." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1854" name="PagingMode" dataType="System.Int32" state="default" isArray="false" description="Specified how you want to loop through multiple pages returned by REST API." typeConverter="ZappySys.Common.RestApiPagingMode, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1855" name="PageNumberAttributeNameInUrl" dataType="System.String" state="default" isArray="false" description="e.g. Type page_num if URL looks like this =&gt; http://abc.com/?page_num=1&amp;sort=true  (page number via query string)&#xA;--or-- Type &lt;%page%&gt; if page number is inside URL path like this =&gt; http://abc.com/1/?sort=true  (e.g. replace page number in url with placeholder http://abc.com/&lt;%page%&gt;/?sort=true)&#xA;Page number will be incremented by one for next URL until last page is reached or [Max Page Number] is reached" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1856" name="MaxPageNumber" dataType="System.Int32" state="default" isArray="false" description="Maximum page number until which auto increment is allowed. Type zero for no limit. Next URL contains next page number (increment by one) until last page is detected or [Max Page Number] limit is reached." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1857" name="StartPageNumberVariable" dataType="System.String" state="default" isArray="false" description="Variable name which will hold starting page number. This is ignored if you useing parameter name from query string to indicate page number." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1858" name="PagingEndStrategy" dataType="System.Int32" state="default" isArray="false" description="Specified how you want detect last page." typeConverter="ZappySys.Common.UrlPagingEndDetectionStrategy, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1859" name="LastPageWhenConditionEqualsTo" dataType="System.Boolean" state="default" isArray="false" description="Condition result to compare to detect last page. Set this property to True if you want detect last page if condition is true else set this to False." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="1860" name="ResponseMinBytes" dataType="System.Int32" state="default" isArray="false" description="Minimum bytes expected from response." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1861" name="ResponseMaxBytes" dataType="System.Int32" state="default" isArray="false" description="Maximum bytes from response." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">3</property>
<property id="1862" name="ResponseErrorString" dataType="System.String" state="default" isArray="false" description="Expected error message sub string from response." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">not found</property>
<property id="1863" name="ResponseStatusCode" dataType="System.Int32" state="default" isArray="false" description="Expected status code from response when page number you trying to access not found." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">404</property>
<property id="4300" name="PrefixTimestamp" dataType="System.Boolean" state="default" isArray="false" description="When you enable this property it will prefix timestamp before Log messages." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4301" name="TreatBlankNumberAsNull" dataType="System.Boolean" state="default" isArray="false" description="Treat empty string as NULL for any numeric data types" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="4302" name="TreatBlankBoolAsNull" dataType="System.Boolean" state="default" isArray="false" description="Treat empty string as NULL for bool data types" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="4303" name="TreatBlankDateAsNull" dataType="System.Boolean" state="default" isArray="false" description="Treat empty string as NULL for any date/time data types" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="4304" name="HttpRequestContentType" dataType="System.Int32" state="default" isArray="false" description="Specifies content type for data you wish to POST. If you select Default option then system default content type will be used (i.e. application/x-www-form-urlencoded). If you specify Content-Type header along with this option then header value takes precedence." typeConverter="ZappySys.Common.Web.HttpRequestContentType, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="4305" name="StopIndicatorAttribute" dataType="System.String" state="default" isArray="false" description="Attribute name or expression for attribute which can be used as stop indicator (e.g. hasmore --or-- $.pagination.hasmore). If this value is blank then NextUrlAttribute is used" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="4306" name="ContineOnAnyError" dataType="System.Boolean" state="default" isArray="false" description="Continue when any type of exception occurs during http request" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4307" name="ContineOnErrorForMessage" dataType="System.Boolean" state="default" isArray="false" description="Continue on error when specified substring found in response" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4308" name="ContineOnErrorForStatusCode" dataType="System.Boolean" state="default" isArray="false" description="Continue on error when specified status code returned from web server" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4309" name="ConsumeResponseOnError" dataType="System.Boolean" state="default" isArray="false" description="When error occurs no data is returned. Use this option to get content eventhough error occurs. When this option is checked you can't use [continue on error when specific string found in response] option" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4310" name="ErrorStatusCodeToMatch" dataType="System.Int32" state="default" isArray="false" description="Status code to match when error occurs and ContineOnErrorForStatusCode option is true. If Response status code matches to this code then task continues to run" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">404</property>
<property id="4311" name="ErrorSubstringToMatch" dataType="System.String" state="default" isArray="false" description="Error substring to match when error occurs and ContineOnErrorForMessage option is true. If Response status code matches to this code then task continues to run" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="4312" name="AllowUnsecureSuite" dataType="System.Boolean" state="default" isArray="false" description="Allow unsecure ciphers/suites and curves for SSLS/TLS communication. Use this option to communicate with web servers which needs legacy / unsecured ciphers support. This option is only trigged when you change default SSL/TLS Version on advanced settings tab." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4313" name="PageNumberIncrement" dataType="System.Int32" state="default" isArray="false" description="Page counter increment. By default next page is incremented by one if this value is zero. You can also enter negative number if you want to decrease page counter." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">1</property>
<property id="4314" name="IncludeParentColumnsWhenChildMissing" dataType="System.Boolean" state="default" isArray="false" description="By default child and parent information is not included in the output if children not found for specified expression. For example if you want to extract all orders from all customers nodes then you can type $.Customers[*].Orders[*]. This will fetch all orders from all customers. By default customers records without orders wont be included in the output. If you want to include those customers where orders not found then check this option (Output null information for order attributes). This behavior is similar to LEFT OUTER JOIN in SQL (Left side is parent, right side is child). This option is ***resource intensive*** so only check if you really care about this behavior." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4315" name="LevelSeparator" dataType="System.String" state="default" isArray="false" description="Property level separator used in generated property name. Use this if default separator is producing duplicate property name which is conflicting with existing name." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">_</property>
<property id="4316" name="FileCompressionType" dataType="System.Int32" state="default" isArray="false" description="Compression format for source file (e.g. gzip, zip)" typeConverter="ZappySys.Common.FileCompressionType, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="4317" name="ArrayTransformationType" dataType="System.Int32" state="default" isArray="false" description="Array Transformation you want to apply. Useful for case when you have 2-Dimensional arrays with rows/columns in separate arrays." typeConverter="ZappySys.Json.ArrayTransformType, ZappySys.Json, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="4318" name="ArrayTransColumnNameFilter" dataType="System.String" state="default" isArray="false" description="Filter expression to use to extract column names for array transformation." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="4319" name="ArrayTransRowValueFilter" dataType="System.String" state="default" isArray="false" description="Filter expression for row values (Not applicable for simple array transformation)." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="4320" name="ArrayTransEnableCustomColumns" dataType="System.Boolean" state="default" isArray="false" description="When you have 2D array but don't have column list specified in a separate array then use this option (e.g. { arr: [[10,11],[21,22]] } )." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="4321" name="ArrayTransCustomColumns" dataType="System.String" state="default" isArray="false" description="When you have 2D array but don't have column list specified in a separate array then use specify column names here. Use comma separated list (e.g col1,col2,col3 ). Column name Order must match value order." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property></properties>
