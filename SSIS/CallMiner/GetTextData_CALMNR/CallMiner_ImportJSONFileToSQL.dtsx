<property id="14" name="PathVariable" dataType="System.String" state="default" isArray="false" description="Variable name which holds data file path or url" typeConverter="ZappySys.PowerPack.Converters.VariableEditor,ZappySys.PowerPack100.UI,Version=1.0.0.0,Culture=neutral,PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">User::VarSourceFilePath</property>
<property id="15" name="DirectPath" dataType="System.String" state="default" isArray="false" description="JSON file file path (e.g. c:\data\myfile.json) or pattern to process multiple files (e.g. c:\data\*.json)" typeConverter="" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" containsID="false" expressionType="Notify">U:\JSON_Output.txt</property>
<property id="16" name="HttpHeaders" dataType="System.String" state="default" isArray="false" description="Set this if you want to set custom Http headers. You may use variable anywhere in the header value using syntax {{User::YourVarName}}. Syntax of Header key value pair is : &amp;lt;request&amp;gt;&amp;lt;header&amp;gt;&amp;lt;name&amp;gt;x-myheader-1&amp;lt;/name&amp;gt;&amp;lt;value&amp;gt;AAA&amp;lt;/value&amp;gt;&amp;lt;/header&amp;gt; &amp;lt;header&amp;gt;&amp;lt;name&amp;gt;x-myheader-2&amp;lt;/name&amp;gt;&amp;lt;value&amp;gt;BBB&amp;lt;/value&amp;gt;&amp;lt;/header&amp;gt;&amp;lt;/request&amp;gt;" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">&lt;request /&gt;</property>
<property id="17" name="HttpRequestData" dataType="System.String" state="default" isArray="false" description="User defined data you wish to send along with your HTTP Request (e.g. Upload file data, Form POST data). Usually you have to set content-type of your data but if you select RequestMethod=POST then system will automatically set content-type=application/x-www-form-urlencoded." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="18" name="HttpRequestMethod" dataType="System.String" state="default" isArray="false" description="Http Web Request Method (e.g. POST, GET, PUT, LIST, DELETE...). By default its GET method. Refer your API documentation if you are not sure which method you have to use." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">GET</property>
<property id="19" name="MaxRows" dataType="System.Int32" state="default" isArray="false" description="Maximum JSON records to fetch. Set this value to 0 for all records" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="20" name="JsonFormat" dataType="System.Int32" state="default" isArray="false" description="Data format coming from HTTP Response. This is useful for example when you have OData service and you want to automatically consume all pages of data using odata.netUrl. Setting JsonFormat=Odata will automatically do it for you. This setting is only applicable if JSON is coming from HTTP WebRequest." typeConverter="ZappySys.Json.JsonFormat, ZappySys.Json, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">1</property>
<property id="21" name="UseProxy" dataType="System.Boolean" state="default" isArray="false" description="Enable proxy settings" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="22" name="ProxyUrl" dataType="System.String" state="default" isArray="false" description="Web URL of Proxy server (including port  if necessary). [e.g. http://myproxyserver:8080/]" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="23" name="UseProxyCreds" dataType="System.Boolean" state="default" isArray="false" description="Enable passing userid and password to proxy server" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="24" name="ProxyUserName" dataType="System.String" state="default" isArray="false" description="Proxy username" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="25" name="ProxyPassword" dataType="System.String" state="default" isArray="false" description="Proxy password" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="26" name="NextUrlAttribute" dataType="System.String" state="default" isArray="false" description="If Service response support pagination using some sort of next url attribute then specify which attribute name in JSON Response string which holds next url. If no attribute found or its null then component will stop fetching next resultset" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="27" name="PrevUrlAttribute" dataType="System.String" state="default" isArray="false" description="If Service response support pagination using some sort of prev/next url attribute then specify which previous link attribute name from JSON Response string which holds previous url." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="28" name="NextUrlStopIndicator" dataType="System.String" state="default" isArray="false" description="Specify value for Next Cursor attribute on which you want to stop processing. If you leave this blank then system will stop fetching next result set when Next Cursor attribute is missing or its blank. If your service sends some numeric value for end of resultset such as -1 then specify it here." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="29" name="NextUrlSuffix" dataType="System.String" state="default" isArray="false" description="If you want to include certain text (or parameters) at the end of Next url then specify this attribute (e.g. &amp;format=json)" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="30" name="NextUrlWait" dataType="System.Int32" state="default" isArray="false" description="This property indicates total number of milliseconds you want to wait before sending next request. This option allows you to adjust how many API calls can be made within certain timeframe. If your API Service has no limit then set this option to zero" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="31" name="ContinueOnUrlNotFoundError" dataType="System.Boolean" state="default" isArray="false" description="If this option is true then component will continue without exception on 404 error (Url not found). This allows you to consume data gracefully." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="32" name="CookieContainerVariable" dataType="System.String" state="default" isArray="false" description="Cookie Container can be used to maintain state between multiple web requests. Example: You can login to site like wordpress and then extract any private page content by simply passing authentication cookies using this variable." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="33" name="Filter" dataType="System.String" state="default" isArray="false" description="Enter expression here to filter data.(Example:  $.Users[*].UserName ) This will fetch User names from users records" typeConverter="" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=10.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" containsID="false" expressionType="Notify">$.Sections[*]</property>
<property id="34" name="IncludeParentColumns" dataType="System.Boolean" state="default" isArray="false" description="Use this option to include parent properties (Non array) in the output along with Filtered Rows" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="35" name="IncludeParentColumnsWithArrayType" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to output parent columns which are array. By default any parent column which is an array is not included in output. See also FilterForParentColumnsWithArrayType property if you set this property" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="36" name="FilterForParentColumnsWithArrayType" dataType="System.String" state="default" isArray="false" description="Set this option to true if you want to output parent columns which are array. By default any parent column which is an array is not included in output. See also FilterForParentColumnsWithArrayType property if you set this property" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="37" name="ParentColumnPrefix" dataType="System.String" state="default" isArray="false" description="Prefix for parent column name. This option is only valid if you have set IncludeParentColumns=True" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">P_</property>
<property id="38" name="ThrowErrorIfPropertyMissing" dataType="System.Boolean" state="default" isArray="false" description="Throw error if property name specified in filter expression is missing. By default it will ignore any missing property errors." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="39" name="MaxLevelsToScan" dataType="System.Int32" state="default" isArray="false" description="This property how many nested levels should be scanned to fetch various properties. 0=Scan all child levels." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="40" name="ExcludedProperties" dataType="System.String" state="default" isArray="false" description="List comma separated property names from JSON document which you want to exclude from output. Specify parent property name to exclude all child nodes." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="41" name="RequestTimeout" dataType="System.Int32" state="default" isArray="false" description="Http request Timeout in seconds. Set this to 0 if you want to use system default value (i.e. 100 seconds)" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="42" name="SecurityProtocol" dataType="System.Int32" state="default" isArray="false" description="Specifies which security protocol is supported for HTTPS communication. Using this option you can enable legacy protocol or enforce to use latest version of security protocol (Note: TLS 1.2 is only supported in SSIS 2014 or Higher)." typeConverter="ZappySys.PowerPack.Common.HttpsSecurityProtocolType, ZappySys.PowerPack100, Version=1.0.0.0, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="43" name="EnableCompressionSupport" dataType="System.Boolean" state="default" isArray="false" description="Enable support for gzip or deflate compression. When you check this option compressed response automatically de-compressed saving bandwidth. This option is only valid if web server supports compressed response stream. Check your API documentation for more information." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="44" name="IgnoreCertificateErrors" dataType="System.Boolean" state="default" isArray="false" description="Ignore SSL certificate related errors. Example: if you getting SSL/TLS errors because of certificate expired or certificate is not from trusted authority or certificate is self-signed. By checking this option you will not get SSL/TLS error." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="45" name="DateFormatString" dataType="System.String" state="default" isArray="false" description="Specifies how custom date formatted strings are parsed when reading JSON." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="46" name="DateParseHandling" dataType="System.Int32" state="default" isArray="false" description="Specifies how date formatted strings, e.g. Date(1198908717056) and 2012-03-21T05:40Z, are parsed when reading JSON." typeConverter="ZappySys.Common.DateParseHandling, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">1</property>
<property id="47" name="OutputRawDocument" dataType="System.Boolean" state="default" isArray="false" description="Output as raw JSON document rather than parsing individual fields. This option is helpful if you have documents stored in a file and you want to pass them downstream as raw JSON string rather than parsing into columns." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="48" name="IndentOutput" dataType="System.Boolean" state="default" isArray="false" description="Indent JSON output so its easy to read." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1881" name="OutputFilePath" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to output FilePath. This option is ignored when you consume DirectValue or data from Url rather than local files. Output column name will be __FilePath" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1882" name="OutputFileName" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to output FileName. This option is ignored when you consume DirectValue or data from Url rather than local files. Output column name will be __FileName" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="1883" name="EnableArchiveFile" dataType="System.Boolean" state="default" isArray="false" description="Set this option to true if you want to move processed file to archive folder." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1884" name="ArchiveFolderPath" dataType="System.String" state="default" isArray="false" description="Folder path where you want to move processed file." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1885" name="OverwriteFileInArchiveFolder" dataType="System.Boolean" state="default" isArray="false" description="Folder path where you want to move processed file." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1886" name="ArchiveFileNamingConvention" dataType="System.String" state="default" isArray="false" description="File naming convention for archived file. By default it will same name as original source file processed. But you can control naming format using {%name%} and {%ext%} placeholders. e.g. {%name%}_processed{%ext%} or {%name%}{%ext%}.{{System::ContainerStartTime,yyyyMMdd_HHmmss_fff}}" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1887" name="UseConnection" dataType="System.Boolean" state="default" isArray="false" description="Use connection to pass credentials for authentication (e.g. Use UserID/Password or Use OAuth Protocol for token based approach)" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1888" name="EnablePivot" dataType="System.Boolean" state="default" isArray="false" description="When this property is true then Column is converted to Row. Pivoted names will appear under  Pivot_Name column and values will appear under Pivot_Value field." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1889" name="PagingMode" dataType="System.Int32" state="default" isArray="false" description="Specified how you want to loop through multiple pages returned by REST API." typeConverter="ZappySys.Common.RestApiPagingMode, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1890" name="PageNumberAttributeNameInUrl" dataType="System.String" state="default" isArray="false" description="e.g. Type page_num if URL looks like this =&gt; http://abc.com/?page_num=1&amp;sort=true  (page number via query string)&#xA;--or-- Type &lt;%page%&gt; if page number is inside URL path like this =&gt; http://abc.com/1/?sort=true  (e.g. replace page number in url with placeholder http://abc.com/&lt;%page%&gt;/?sort=true)&#xA;Page number will be incremented by one for next URL until last page is reached or [Max Page Number] is reached" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1891" name="MaxPageNumber" dataType="System.Int32" state="default" isArray="false" description="Maximum page number until which auto increment is allowed. Type zero for no limit. Next URL contains next page number (increment by one) until last page is detected or [Max Page Number] limit is reached." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1892" name="StartPageNumberVariable" dataType="System.String" state="default" isArray="false" description="Variable name which will hold starting page number. This is ignored if you useing parameter name from query string to indicate page number." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1893" name="PagingEndStrategy" dataType="System.Int32" state="default" isArray="false" description="Specified how you want detect last page." typeConverter="ZappySys.Common.UrlPagingEndDetectionStrategy, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1894" name="LastPageWhenConditionEqualsTo" dataType="System.Boolean" state="default" isArray="false" description="Condition result to compare to detect last page. Set this property to True if you want detect last page if condition is true else set this to False." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="1895" name="ResponseMinBytes" dataType="System.Int32" state="default" isArray="false" description="Minimum bytes expected from response." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1896" name="ResponseMaxBytes" dataType="System.Int32" state="default" isArray="false" description="Maximum bytes from response." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">3</property>
<property id="1897" name="ResponseErrorString" dataType="System.String" state="default" isArray="false" description="Expected error message sub string from response." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">not found</property>
<property id="1898" name="ResponseStatusCode" dataType="System.Int32" state="default" isArray="false" description="Expected status code from response when page number you trying to access not found." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">404</property>
<property id="1923" name="PrefixTimestamp" dataType="System.Boolean" state="default" isArray="false" description="When you enable this property it will prefix timestamp before Log messages." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1924" name="TreatBlankNumberAsNull" dataType="System.Boolean" state="default" isArray="false" description="Treat empty string as NULL for any numeric data types" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="1925" name="TreatBlankBoolAsNull" dataType="System.Boolean" state="default" isArray="false" description="Treat empty string as NULL for bool data types" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="1926" name="TreatBlankDateAsNull" dataType="System.Boolean" state="default" isArray="false" description="Treat empty string as NULL for any date/time data types" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">true</property>
<property id="1927" name="HttpRequestContentType" dataType="System.Int32" state="default" isArray="false" description="Specifies content type for data you wish to POST. If you select Default option then system default content type will be used (i.e. application/x-www-form-urlencoded). If you specify Content-Type header along with this option then header value takes precedence." typeConverter="ZappySys.Common.Web.HttpRequestContentType, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1928" name="StopIndicatorAttribute" dataType="System.String" state="default" isArray="false" description="Attribute name or expression for attribute which can be used as stop indicator (e.g. hasmore --or-- $.pagination.hasmore). If this value is blank then NextUrlAttribute is used" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1929" name="ContineOnAnyError" dataType="System.Boolean" state="default" isArray="false" description="Continue when any type of exception occurs during http request" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1930" name="ContineOnErrorForMessage" dataType="System.Boolean" state="default" isArray="false" description="Continue on error when specified substring found in response" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1931" name="ContineOnErrorForStatusCode" dataType="System.Boolean" state="default" isArray="false" description="Continue on error when specified status code returned from web server" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1932" name="ConsumeResponseOnError" dataType="System.Boolean" state="default" isArray="false" description="When error occurs no data is returned. Use this option to get content eventhough error occurs. When this option is checked you can't use [continue on error when specific string found in response] option" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1933" name="ErrorStatusCodeToMatch" dataType="System.Int32" state="default" isArray="false" description="Status code to match when error occurs and ContineOnErrorForStatusCode option is true. If Response status code matches to this code then task continues to run" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">404</property>
<property id="1934" name="ErrorSubstringToMatch" dataType="System.String" state="default" isArray="false" description="Error substring to match when error occurs and ContineOnErrorForMessage option is true. If Response status code matches to this code then task continues to run" typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1935" name="AllowUnsecureSuite" dataType="System.Boolean" state="default" isArray="false" description="Allow unsecure ciphers/suites and curves for SSLS/TLS communication. Use this option to communicate with web servers which needs legacy / unsecured ciphers support. This option is only trigged when you change default SSL/TLS Version on advanced settings tab." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1936" name="PageNumberIncrement" dataType="System.Int32" state="default" isArray="false" description="Page counter increment. By default next page is incremented by one if this value is zero. You can also enter negative number if you want to decrease page counter." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">1</property>
<property id="1937" name="IncludeParentColumnsWhenChildMissing" dataType="System.Boolean" state="default" isArray="false" description="By default child and parent information is not included in the output if children not found for specified expression. For example if you want to extract all orders from all customers nodes then you can type $.Customers[*].Orders[*]. This will fetch all orders from all customers. By default customers records without orders wont be included in the output. If you want to include those customers where orders not found then check this option (Output null information for order attributes). This behavior is similar to LEFT OUTER JOIN in SQL (Left side is parent, right side is child). This option is ***resource intensive*** so only check if you really care about this behavior." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1938" name="LevelSeparator" dataType="System.String" state="default" isArray="false" description="Property level separator used in generated property name. Use this if default separator is producing duplicate property name which is conflicting with existing name." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">_</property>
<property id="1939" name="FileCompressionType" dataType="System.Int32" state="default" isArray="false" description="Compression format for source file (e.g. gzip, zip)" typeConverter="ZappySys.Common.FileCompressionType, ZappySys.Common, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1940" name="ArrayTransformationType" dataType="System.Int32" state="default" isArray="false" description="Array Transformation you want to apply. Useful for case when you have 2-Dimensional arrays with rows/columns in separate arrays." typeConverter="ZappySys.Json.ArrayTransformType, ZappySys.Json, Version=1.0.2018.10417, Culture=neutral, PublicKeyToken=1903265a93eae502" UITypeEditor="" containsID="false" expressionType="Notify">0</property>
<property id="1941" name="ArrayTransColumnNameFilter" dataType="System.String" state="default" isArray="false" description="Filter expression to use to extract column names for array transformation." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1942" name="ArrayTransRowValueFilter" dataType="System.String" state="default" isArray="false" description="Filter expression for row values (Not applicable for simple array transformation)." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property>
<property id="1943" name="ArrayTransEnableCustomColumns" dataType="System.Boolean" state="default" isArray="false" description="When you have 2D array but don't have column list specified in a separate array then use this option (e.g. { arr: [[10,11],[21,22]] } )." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify">false</property>
<property id="1944" name="ArrayTransCustomColumns" dataType="System.String" state="default" isArray="false" description="When you have 2D array but don't have column list specified in a separate array then use specify column names here. Use comma separated list (e.g col1,col2,col3 ). Column name Order must match value order." typeConverter="" UITypeEditor="" containsID="false" expressionType="Notify"></property></properties>
