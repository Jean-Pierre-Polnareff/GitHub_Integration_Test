<![CDATA[/*
   Microsoft SQL Server Integration Services Script Task
   Write scripts using Microsoft Visual C# 2008.
   The ScriptMain is the entry point class of the script.
*/

using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using Microsoft.Office.Interop.Excel; 

namespace ST_2a5de1eb3fd344a4b4e0599841ba1d1a.csproj
{
    [System.AddIn.AddIn("ScriptMain", Version = "1.0", Publisher = "", Description = "")]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {

        #region VSTA generated code
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
        public void Main()
        {
            //Call Miner Buster
            refreshExcel("\\\\mnsql5\\EXCELREPORTS\\CallMiner\\CallMinerBuster.xlsm", 40000);

            //Bad Phones Buster
            refreshExcel("\\\\mnsql5\\EXCELREPORTS\\CallMiner\\BadPhonesBuster.xlsm", 40000);         

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        private void refreshExcel(string fileName, int sleepTime)
        {
            object nullValue = System.Reflection.Missing.Value;
            Microsoft.Office.Interop.Excel.Application excelApp = new Microsoft.Office.Interop.Excel.ApplicationClass();
            Microsoft.Office.Interop.Excel.Workbook excelWB = null;

            excelWB = excelApp.Workbooks.Open(fileName,
               nullValue,  //updatelinks
               false,      //readonly
               nullValue,  //format
               nullValue,  //Password
               nullValue,  //writeResPass
               true,       //ignoreReadOnly
               nullValue,  //origin
               nullValue,  //delimiter
               true,       //editable
               nullValue,  //Notify
               nullValue,  //converter
               nullValue,  //AddToMru
               nullValue,  //Local
               nullValue); //corruptLoad

            excelWB.RefreshAll();

            System.Threading.Thread.Sleep(sleepTime);

            excelWB.Save();

            System.Threading.Thread.Sleep(sleepTime);

            if (excelWB != null)
            {
                excelWB.Close(false, fileName, null);
                System.Runtime.InteropServices.Marshal.ReleaseComObject(excelWB);
                excelWB = null;
            }
            if (excelApp != null)
            {
                excelApp.Quit();
                System.Runtime.InteropServices.Marshal.ReleaseComObject(excelApp);
                excelApp = null;
            }

        }
    }
}]]></ProjectItem><ProjectItem Name="\properties\resources.designer.cs">
