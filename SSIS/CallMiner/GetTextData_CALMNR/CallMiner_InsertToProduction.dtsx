<![CDATA[/*
   Microsoft SQL Server Integration Services Script Task
   Write scripts using Microsoft Visual C# 2008.
   The ScriptMain is the entry point class of the script.
*/

using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;

namespace ST_312ec66177b34e80bcc4326f68308a54.csproj
{
    [System.AddIn.AddIn("ScriptMain", Version = "1.0", Publisher = "", Description = "")]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {

        #region VSTA generated code
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
       

        public void Main()
        {

            Dts.Variables["User::RecordCountMessage"].Value = 
            Dts.Variables["User::RecordCountMessage_AttributeInsert"].Value.ToString()
            +Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_CategoryInsert"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_ContactInsert"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_ScoreWeightInsert"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_BucketInsert"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_BucketUpdate"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_ScoreComponentInsert"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_ScoreComponentUpdate"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_ScoresInsert"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_ScoresUpdate"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_SectionInsert"].Value.ToString()
            + Environment.NewLine +
            Dts.Variables["User::RecordCountMessage_SectionUpdate"].Value.ToString();

            //MessageBox.Show(Dts.Variables["User::RecordCountMessage"].Value.ToString());

            Dts.TaskResult = (int)ScriptResults.Success;
        }
    }
}]]></ProjectItem><ProjectItem Name="\properties\settings.designer.cs">
