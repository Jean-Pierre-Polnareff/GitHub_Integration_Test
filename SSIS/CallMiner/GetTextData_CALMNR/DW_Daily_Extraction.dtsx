              SQLTask:Connection="{7FEB10FC-D92F-410E-9476-741E5B702607}"
              SQLTask:BypassPrepare="False"
              SQLTask:SqlStatementSource=" &#xA;SET NOCOUNT ON &#xA;&#xA;DECLARE @packagename VARCHAR(50); SET @packagename = ?&#xA;DECLARE @sourcename VARCHAR(50); SET @sourcename = ?&#xA;DECLARE @taskname VARCHAR(50); SET @taskname = ?&#xA;DECLARE @message VARCHAR(50); SET @message = ?&#xA;DECLARE @executioninstanceguid VARCHAR(50); SET @executioninstanceguid = ?&#xA;&#xA;IF (@message like '%wrote%' and @message like '%rows%') &#xA;BEGIN &#xA;&#x9;IF NOT EXISTS (SELECT 1 FROM PackageInstance &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE packagename = @packagename &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;AND executioninstanceguid = @executioninstanceguid)  &#xA;&#x9;BEGIN &#xA;&#x9;&#x9;INSERT INTO PackageInstance &#xA;&#x9;&#x9;(packagename, executioninstanceguid) &#xA;&#x9;&#x9;VALUES &#xA;&#x9;&#x9;(@packagename, @executioninstanceguid) &#xA;&#x9;END &#xA;&#xA;&#x9;INSERT INTO PackageMessageLog &#xA;&#x9;(packagename, sourcename, taskname, [message], executioninstanceguid, update_time)&#xA;&#x9;VALUES &#xA;&#x9;(@packagename, @sourcename, @taskname, @message, @executioninstanceguid, getdate()) &#xA;&#xA;&#x9;-- parse message &#xA;&#x9;DECLARE @rows_coming VARCHAR(50); SET @rows_coming = (SELECT NameValue FROM (SELECT CASE WHEN try_parse(replace(replace(replace(value,'wrote',''),'rows',''),'.','') AS INT) IS NULL THEN 0 ELSE 1 END KeyValue, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;replace(replace(replace(value,'wrote',''),'rows',''),'.','') NameValue  &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM string_split(@message,'&quot;') &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE value != '') t WHERE KeyValue = 1)&#xA;&#xA;&#x9;DECLARE @entity varchar(100); set @entity = (SELECT NameValue FROM (SELECT CASE WHEN  try_parse(replace(replace(replace(value,'wrote',''),'rows',''),'.','') AS INT) IS NULL THEN 0 ELSE 1 END KeyValue, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;replace(replace(replace(value,'wrote',''),'rows',''),'.','') NameValue  &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM string_split(@message,'&quot;') &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHERE value != '') t WHERE KeyValue = 0)&#xA;&#xA;&#x9;DECLARE @rows INT; SET @rows = try_parse(@rows_coming as int) &#xA;&#xA;&#x9;IF PATINDEX('-', @entity) &gt; 0 &#xA;&#x9;BEGIN &#xA;&#x9;&#x9;declare @server varchar(50); &#xA;&#xA;&#x9;&#x9;select @server = value  &#xA;&#x9;&#x9;from (&#xA;&#x9;&#x9;select *, ROW_NUMBER() over (order by @entity) r  &#xA;&#x9;&#x9;FROM string_split(@entity,'-') &#xA;&#x9;&#x9;) t &#xA;&#x9;&#x9;WHERE r = 1 &#xA;&#xA;&#x9;&#x9;select @entity = value  &#xA;&#x9;&#x9;from (&#xA;&#x9;&#x9;select *, ROW_NUMBER() over (order by @entity) r  &#xA;&#x9;&#x9;FROM string_split(@entity,'-') &#xA;&#x9;&#x9;) t &#xA;&#x9;&#x9;WHERE r = 2 &#xA;  &#xA;&#x9;&#x9;select @server, @entity &#xA;&#x9;END &#xA;&#xA;&#x9;IF @entity is not null&#xA;&#x9;BEGIN &#xA;&#x9;&#x9;IF EXISTS (SELECT 1 FROM PackageCounters WHERE packagename = @packagename and @sourcename = sourcename and @entity = taskname and executioninstanceguid = @executioninstanceguid) &#xA;&#x9;&#x9;BEGIN &#xA;&#x9;&#x9;&#x9;UPDATE P  &#xA;&#x9;&#x9;&#x9;SET Rows_Processing = @rows  &#xA;&#x9;&#x9;&#x9;FROM PackageCounters p &#xA;&#x9;&#x9;&#x9;WHERE packagename = @packagename and @sourcename = sourcename and @entity = taskname and executioninstanceguid = @executioninstanceguid &#xA;&#x9;&#x9;END &#xA;&#x9;&#x9;ELSE &#xA;&#x9;&#x9;BEGIN &#xA;&#x9;&#x9;&#x9;INSERT INTO PackageCounters &#xA;&#x9;&#x9;&#x9;(packagename,sourcename,taskname,executioninstanceguid,Rows_Processing)&#xA;&#x9;&#x9;&#x9;VALUES &#xA;&#x9;&#x9;&#x9;(@packagename,@sourcename,@entity,@executioninstanceguid,@rows )&#xA;&#x9;&#x9;END &#xA;&#x9;END &#xA;&#xA;&#x9;DECLARE @space AS TABLE(name VARCHAR(50), rows INT, reserved VARCHAR(50), data VARCHAR(50), index_size VARCHAR(50), unused VARCHAR(50)) &#xA;&#x9;INSERT INTO @space &#xA;&#x9;EXEC sp_spaceused @entity &#xA;&#xA;&#x9;UPDATE P  &#xA;&#x9;SET Rows_Final = s.rows  &#xA;&#x9;FROM PackageCounters p &#xA;&#x9;&#x9;JOIN @space s ON s.name = p.taskname &#xA;&#x9;WHERE packagename = @packagename and sourcename =  @sourcename and taskname = @entity and executioninstanceguid = @executioninstanceguid &#xA;&#xA;END &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="System::PackageName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="50" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="System::SourceName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="50" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="2"
                SQLTask:DtsVariableName="System::TaskName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="50" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="3"
                SQLTask:DtsVariableName="System::ErrorDescription"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="50" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="4"
                SQLTask:DtsVariableName="System::ExecutionInstanceGUID"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="129"
                SQLTask:ParameterSize="50" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:EventHandler>
