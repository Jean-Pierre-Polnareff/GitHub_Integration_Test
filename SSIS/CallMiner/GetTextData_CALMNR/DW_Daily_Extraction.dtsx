                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT A.Client,
LEFT(A.AcctNUM_From_Client,1)||RIGHT(A.AcctNUM_From_Client,4) as AcctNUM_From_Client,
CAST(A.Service_Date AS VARCHAR(12)) AS Service_Date,
CAST(A.Delinquency_Date AS VARCHAR(12)) AS Delinquency_Date,
CAST(A.Date_Listed AS VARCHAR(12)) AS Date_Listed,
A.Forward_In_Clnt,
A.CONTRACT_STATE,
A.ACCOUNT_NUM 
FROM SQLUser.Dbtr_Clnt_Generl_Inf A
WHERE A.DATE_LISTED &gt;=DATEADD(D, -5, CURRENT_DATE)
 AND A.DATE_LISTED &lt; DATEADD(D, 0, CURRENT_DATE) AND A.CLIENT NOT LIKE '9%' AND A.CLIENT NOT LIKE 'LCI%' AND A.CLIENT NOT LIKE 'Z%'  AND A.ACCOUNT_NUM != 2207301</property>
