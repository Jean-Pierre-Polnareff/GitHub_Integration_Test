            <DTS:Executable
              DTS:refId="Package\EXTRACTION\Cache Extraction\ElectronicPay_Debtor"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:DelayValidation="True"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{803B8BB2-51BE-4334-9BA6-F0C5C234209E}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="ElectronicPay_Debtor"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:PropertyExpression
                DTS:Name="[Electronic_Pay_Debtor].[SqlCommand]">"SELECT ACCOUNT_NUM,
Pending_E_Pmt_Index,
Promised_Amount,
Courtesy_Fee,
Due_Date,
Payment_Type,
Bank_Account_Type,
Check_Number,
Payer_Name,
Payer_Address_1,
Payer_Address_2,
Payer_City,
Payer_State,
Payer_Zip_Code,
Validator_User_ID,
Entered_By_User_ID,
Entered_Date,
Payment_Source,
Payment_Detail,
Pmt_Chared_To_Acct,
Cancel_Flag,
Payment_Template,
Arrangement_ID,
Ltr_Request_Date
FROM SQLUSER.ELECTRONICPAY_DEBTOR
WHERE DUE_DATE &gt;=DATEADD(D, " + (DT_WSTR, 4) ( @[User::nDays] - 1 )  + ", CURRENT_DATE)
 AND DUE_DATE &lt; DATEADD(D, " + (DT_WSTR, 4) @[User::nDay] + ", CURRENT_DATE) "</DTS:PropertyExpression>
              <DTS:ObjectData>
                <pipeline
                  version="1">
                  <components>
                    <component
                      refId="Package\EXTRACTION\Cache Extraction\ElectronicPay_Debtor\Data Conversion"
                      componentClassID="Microsoft.DataConvert"
