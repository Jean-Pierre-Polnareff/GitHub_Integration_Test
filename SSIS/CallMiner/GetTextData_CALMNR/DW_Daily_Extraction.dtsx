              <DTS:Variables />
              <DTS:PropertyExpression
                DTS:Name="[Dbtr_CInt_General_Inf].[SqlCommand]">"SELECT A.Client,
LEFT(A.AcctNUM_From_Client,1)||RIGHT(A.AcctNUM_From_Client,4) as AcctNUM_From_Client,
CAST(A.Service_Date AS VARCHAR(12)) AS Service_Date,
CAST(A.Delinquency_Date AS VARCHAR(12)) AS Delinquency_Date,
CAST(A.Date_Listed AS VARCHAR(12)) AS Date_Listed,
A.Forward_In_Clnt,
A.CONTRACT_STATE,
A.ACCOUNT_NUM 
FROM SQLUser.Dbtr_Clnt_Generl_Inf A
WHERE A.DATE_LISTED &gt;=DATEADD(D, " + (DT_WSTR, 4) @[User::nDays]  + ", CURRENT_DATE)
 AND A.DATE_LISTED &lt; DATEADD(D, " + (DT_WSTR, 4) @[User::nDay] + ", CURRENT_DATE) AND A.CLIENT NOT LIKE '9%' AND A.CLIENT NOT LIKE 'LCI%' AND A.CLIENT NOT LIKE 'Z%'  AND A.ACCOUNT_NUM != 2207301"</DTS:PropertyExpression>
