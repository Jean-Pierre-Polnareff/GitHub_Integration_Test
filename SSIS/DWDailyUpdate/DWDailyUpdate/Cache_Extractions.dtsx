              <DTS:Variables />
              <DTS:PropertyExpression
                DTS:Name="[Dbtr_CInt_General_Inf].[SqlCommand]">"SELECT A.Client,
LEFT(A.AcctNUM_From_Client,1)||RIGHT(A.AcctNUM_From_Client,4) as AcctNUM_From_Client,
CAST(A.Service_Date AS VARCHAR(12)) AS Service_Date,
CAST(A.Delinquency_Date AS VARCHAR(12)) AS Delinquency_Date,
CAST(A.Date_Listed AS VARCHAR(12)) AS Date_Listed,
A.Forward_In_Clnt,
A.CONTRACT_STATE,
A.ACCOUNT_NUM 
FROM SQLUser.Dbtr_Clnt_Generl_Inf A
WHERE A.DATE_LISTED &gt;= DATEADD(D, " + (DT_WSTR, 4) @[User::nDays]   + ", CURRENT_DATE) 
AND A.DATE_LISTED &lt; DATEADD(D, " + (DT_WSTR, 4) @[User::nDay] + ", CURRENT_DATE) AND A.CLIENT NOT LIKE '9%' AND A.CLIENT NOT LIKE 'LCI%' AND A.CLIENT NOT LIKE 'Z%'  AND A.ACCOUNT_NUM != 2207301 

AND A.ACCOUNT_NUM in (10223460,1147256,1147301,1147304,1147309,1152813,1177375,1177376,1177377,1177378,1177379,1177380,1177381,1177382,1177383,1177384,1177385,1177386,1177387,1177388,1177389,1177390,1177391,1177392,1177393,1177394,1177395,1177396,1177457,1177500,
