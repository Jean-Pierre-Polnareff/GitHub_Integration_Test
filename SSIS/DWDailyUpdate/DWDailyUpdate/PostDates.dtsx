      DTS:refId="Package\Insert into DW_MSTR_DM TBL_Customer_PostDates"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E7EDE362-984E-4664-A246-C87DB8C725C1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insert into DW_MSTR_DM TBL_Customer_PostDates"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server 2008; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{22E89CA3-094D-4640-98B9-2552919211DC}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO DW_MSTR_DM.dbo.TBL_Customer_PostDates&#xA;(  &#xA;   CUSTOMER_ID &#xA;  ,PROMISE_PAY_DATE &#xA;  ,PROMISE_PAYMENT &#xA;  ,PAYMENT_TYPE &#xA;  ,CLIENT_NUMBER &#xA;  ,CLIENT_ID &#xA;  ,NAME &#xA;  ,LIST_DATE &#xA;  ,IMPORT_DATE&#xA;  ,Coll_ID&#xA;)&#xA;SELECT DISTINCT &#xA; CAST(df.CUSTOMER_ID AS BIGINT) AS Customer_id&#xA;,CAST(df.PROMISE_PAY_DATE AS DATETIME) AS Promise_Pay_Date&#xA;,CAST(df.PROMISE_PAYMENT AS NUMERIC(18,2)) AS Promise_Payment&#xA;,CAST(df.PAYMENT_TYPE AS VARCHAR(50)) AS Payment_Type&#xA;,CAST(df.CLIENT_NUMBER AS VARCHAR(50)) AS Client_Number&#xA;,CAST(df.CLIENT_ID AS VARCHAR(50)) AS Client_Id&#xA;,CAST(df.NAME AS VARCHAR(100)) AS Name&#xA;,CAST(df.LIST_DATE AS VARCHAR(50)) AS List_Date&#xA;,GETDATE() AS IMPORT_DATE&#xA;,CAST(df.Coll_ID AS VARCHAR(10)) AS Coll_ID&#xA;FROM&#xA;DW_STAGING.dbo.dfPostDates df" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
