          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[/*
   Microsoft SQL Server Integration Services Script Task
   Write scripts using Microsoft Visual C# 2008.
   The ScriptMain is the entry point class of the script.
*/

using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.IO;

namespace ST_f68ce6cc993e4bf29599517eb9de9391.csproj
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {

        #region VSTA generated code
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion


        public void Main()
        {

            copyFile("\\\\MNSQL5\\excelreports\\BEAT\\BEAT_DASHBOARD.xlsm", "\\\\northland\\colmgr\\BusinessIntelligenceRpts\\Liquidation_Tracking_Tool\\");
            copyFile("\\\\MNSQL5\\excelreports\\BEAT\\BEAT_DASHBOARD.xlsm", "\\\\northland\\colmgr\\BusinessIntelligenceRpts\\Liquidation_Tracking_Tool\\History\\");
            copyFile("\\\\Mnsql5\\excelreports\\Collection_Summary.xlsm", "\\\\northland\\Colmgr\\BusinessIntelligenceRpts\\Payments\\");

            Dts.TaskResult = (int)ScriptResults.Success;

        }

        public void copyFile(string sourceFilePath, string productionFilePath)
        {
            //SET DATE FOR FILE TIMESTAMP
            string datetime = DateTime.Now.ToString("MMddyyyyHHmm");

            //SET FILE NAMES AND APPEND WITH DATE
            string destinationName = Path.GetFileNameWithoutExtension(sourceFilePath) + '_' + datetime + Path.GetExtension(sourceFilePath);

            //COPY FILES  
            try
            {
                File.Copy(sourceFilePath, productionFilePath + destinationName, true);
            }
            catch
            {

            }
        }

    }
}]]></ProjectItem>
