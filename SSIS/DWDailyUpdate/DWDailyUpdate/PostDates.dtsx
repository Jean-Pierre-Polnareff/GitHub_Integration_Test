    <DTS:Executable
      DTS:refId="Package\SQL Check If Job Ran Today"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="SQL Check If Job Ran Today"
      DTS:DTSID="{B4D7C548-F1B0-4BFD-963B-89C3D3C39EB5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Check If Job Ran Today"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server 2008; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0A89E834-9A0D-4160-A304-B86DB758AD1A}"
          SQLTask:SqlStatementSource="SELECT MIN(DATEDIFF(DAY,IMPORT_DATE,GETDATE())) AS DaysDelinquent FROM dw_mstr_dm.dbo.TBL_Customer_PostDates"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="DaysDelinquent"
            SQLTask:DtsVariableName="User::DaysDelinquent" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
