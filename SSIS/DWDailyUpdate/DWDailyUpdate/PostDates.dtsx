          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[/*
   Microsoft SQL Server Integration Services Script Task
   Write scripts using Microsoft Visual C# 2008.
   The ScriptMain is the entry point class of the script.
*/

using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
using System.IO;

namespace ST_ace62e9e902341c9a0dd6989e1912a7b.csproj
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {

        #region VSTA generated code
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion

        public void Main()
        {
            // Delete files older than 12 hours for everything in the directory
            string fileDestination1 = "\\\\northland\\Colmgr\\BusinessIntelligenceRpts\\BAMPDC\\";
            string fileDestination2 = "\\\\northland\\Colmgr\\BusinessIntelligenceRpts\\Liquidation_Tracking_Tool\\";
            string fileDestination3 = "\\\\ngi-facs\\dw\\PD\\";
            
            deleteFiles(fileDestination1);
            deleteFiles(fileDestination2);
            deleteFiles(fileDestination3);


            // Delete all files older than 12 hours except where files to keep is specified.            
            string fileDestination4 = "\\\\northland\\Colmgr\\BusinessIntelligenceRpts\\Payments\\";
            string fileToKeep = "PayerAccountMethodTracker";
            string[] fileList = Directory.GetFiles(fileDestination4);

            foreach (string file in fileList)
            {

                if (File.Exists(file))
                {

                    if (File.GetCreationTime(file) < DateTime.Now.AddHours(-12))
                    {

                        try
                        {
                            if (file.IndexOf(fileToKeep, StringComparison.OrdinalIgnoreCase) >= 0)
                            {
                                //MessageBox.Show("keep" + file);
                            }
                            else
                            {
                                //MessageBox.Show("delete" + file);
                                File.Delete(file);
                            }
                        }
                        catch (Exception e)
                        {
                            //MessageBox.Show("error.");                    
                            //do nothing. Files will get deleted when they are no longer in use.
                        }
                    }
                }

            }
        
            Dts.TaskResult = (int)ScriptResults.Success;

        }


        private void deleteFiles(string fileDestination)
        {
            string[] fileList = Directory.GetFiles(fileDestination);

            foreach (string file in fileList)
            {
                if (File.Exists(file))
                {
                    if (File.GetCreationTime(file) < DateTime.Now.AddHours(-12))
                    {
                        try
                        {
                            File.Delete(file);

                        }
                        catch (Exception e)
                        {
                            //MessageBox.Show("error.");                    
                            //do nothing. Files will get deleted when they are no longer in use.
                        }
                    }
                }
            }

        }

    }
}]]></ProjectItem>
