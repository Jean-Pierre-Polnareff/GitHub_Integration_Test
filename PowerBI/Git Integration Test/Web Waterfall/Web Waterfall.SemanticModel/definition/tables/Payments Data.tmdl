	measure 'Payment $' =
			
			---VAR selectedmonth =ALLSELECTED('Metrics Data'[CapturedOn].[Month])
			---VAR selectedyear = ALLSELECTED('Metrics Data'[CapturedOn].[Year])
			VAR selectedmonthyear = ALLSELECTED('Metrics Data'[Month-Year])
			return
			IF(
			[DefaultSelection]=[AllSelections] ,
			CALCULATE(SUM('Payments Data'[payments]),
			FILTER('Metrics Data','Metrics Data'[Month-Year]=FORMAT(today()-1,"MMM-YY"))),
			---FILTER('Metrics Data',month('metrics data'[capturedon])=month(today()-1) && Year('metrics data'[capturedon])=Year(today()-1))),
			
			
			CALCULATE(SUM('Payments Data'[payments]),
			FILTER('Metrics Data','Metrics Data'[Month-Year]=selectedmonthyear)))
			---FILTER('Metrics Data','metrics data'[capturedon].[month]=selectedmonth && 'metrics data'[capturedon].[Year]=selectedyear)))
		formatString: \$#,0;(\$#,0);\$#,0
		isHidden
		lineageTag: 01f4e83b-898a-40fe-b761-5df20639599f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

