	measure 'Client Summary Payments $' =
			
			VAR varKM13 = UPPER(IF(HASONEVALUE(KM[Month]),VALUES(KM[Month]),BLANK()))
			VAR CurrentMTDPayments = CALCULATE([Current MTD Payments $],ALL(KM[Month],KM[KM]))
			VAR PreviousMTDPayments = CALCULATE([Previous MTD Payments $],ALL(KM[Month],KM[KM]))
			----VAR MTDConversionBW = CALCULATE([# B/(W) Conversion #],ALL(KM[KM],KM[Column1]))
			VAR MTDPaymentsDifferencePercentage = CALCULATE([% B/(W) Payments $],ALL(KM[Month],KM[KM]))
			VAR Currentmmmm=format(today()-1,"mmmm")
			VAR Previousmmmm = format(Month((Today()-1)-1),"mmmm")
			VAR Pctdiffmmmm =  "Percent diff from " & format(Month((Today()-1)-1),"mmmm")
			RETURN
			SWITCH(varKM13,
			Currentmmmm,format(CurrentMTDPayments,"$#,##0"),
			Previousmmmm,format(PreviousMTDPayments,"$#,##0")
			,
			----"# Diff from Previous",format(MTDConversionBW,"0%;(0%)"),
			Pctdiffmmmm,format(MTDPaymentsDifferencePercentage,"0%;(0%)")
			)
		isHidden
		lineageTag: 45d4809b-86fd-463e-94b3-da2ba5fc5762

