table 'AXP Payment Program Detail'
	isHidden
	lineageTag: 69fda654-5647-4407-b27e-94f354e4b627

	measure 'Enrollments (#)' = CALCULATE(DISTINCTCOUNT('AXP Payment Program Detail'[SessionId]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled")
		formatString: #,0
		isHidden
		lineageTag: c49d18f4-16b1-435b-a1c0-820f536579f7

		changedProperty = FormatString

		changedProperty = IsHidden

	measure Viewed = CALCULATE(DISTINCTCOUNT('AXP Payment Program Detail'[SessionId]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_offers_list"), 'AXP Payment Program Detail'[Campaign] = "Viewed")
		formatString: #,0
		isHidden
		lineageTag: 5a4385ba-969c-423d-a3ff-dc66304ab8ad

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Enrolled %' = CALCULATE(DIVIDE([Enrollments (#)], [Viewed]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		isHidden
		lineageTag: 3d58d290-cdbd-4f8d-9791-db7d075eec11

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Enrolled Balances' =
			CALCULATE(SUM('AXP Payment Program Detail'[InitialBalance]) - sum('AXP Payment Program Detail'[Payments]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled")
			---CALCULATE(SUM('AXP Payment Program Detail'[InitialBalance]) - sum('AXP Payment Program Detail'[total_collections]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled")
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		isHidden
		lineageTag: e6a381e3-be04-4875-990e-900254def4ce

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Enrolled Payment $' =
			
			CALCULATE(SUM('AXP Payment Program Detail'[Payments]), KEEPFILTERS( 'AXP Payment Program Detail'[Campaign] = "Enrolled"), 'AXP Payment Program Detail'[Key] = "checking_account_used" || 'AXP Payment Program Detail'[Key] = "debit_card_used" || 'AXP Payment Program Detail'[Key] = "credit_card_used")
			-----CALCULATE(SUM('AXP Payment Program Detail'[total_collections]), KEEPFILTERS( 'AXP Payment Program Detail'[Campaign] = "Enrolled"), 'AXP Payment Program Detail'[Key] = "checking_account_used" || 'AXP Payment Program Detail'[Key] = "debit_card_used" || 'AXP Payment Program Detail'[Key] = "credit_card_used")
			----CALCULATE(SUM('AXP Payment Program Detail'[Payments]), KEEPFILTERS( 'AXP Payment Program Detail'[Campaign] = "Enrolled"))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		isHidden
		lineageTag: 91fbe29b-5e94-4979-ba2d-bf68c82882d2

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Enrolled Future Payment $ Set Up' =
			
			VAR PaySeriesAmount = CALCULATE(SUM('AXP Payment Program Detail'[PaySeriesAmount]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled")
			VAR PaySeriesCount = CALCULATE(SUM('AXP Payment Program Detail'[PaySeriesCount]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled")
			
			RETURN
			CALCULATE(PaySeriesCount * PaySeriesAmount)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		isHidden
		lineageTag: 1fa366d9-1826-43f8-adae-c575adcb67fd

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Enrolled Average Term (months)' =
			
			VAR Monthly = CALCULATE(SUM('AXP Payment Program Detail'[PaySeriesCount]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled", 'AXP Payment Program Detail'[PaySeriesFrequency] = "Monthly")
			VAR BiWeekly  = DIVIDE(CALCULATE(SUM('AXP Payment Program Detail'[PaySeriesCount]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled", 'AXP Payment Program Detail'[PaySeriesFrequency] = "BiWeekly"), 2)
			RETURN
			
			CALCULATE(DIVIDE((Monthly + BiWeekly),[Enrollments (#)]))
		formatString: #,0
		isHidden
		lineageTag: 1f41ff2a-413a-40c7-ad2d-805945ae7c20

		changedProperty = FormatString

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Enrollments Oasis (#)' = CALCULATE(DISTINCTCOUNT('AXP Payment Program Detail'[SessionId]), KEEPFILTERS('AXP Payment Program Detail'[Key] = "program_enrollment"), 'AXP Payment Program Detail'[Campaign] = "Enrolled",'AXP Payment Program Detail'[Description] = "Oasis")
		formatString: 0
		isHidden
		lineageTag: 9eb9434d-1403-4f8e-a9a3-8c56f29fad9a

		changedProperty = IsHidden

	measure 'AXP Programs DateRange' =
			
			VAR RangeStart = FORMAT(Min('AXP Payment Program Detail'[CapturedOn]),"m/d/yyyy")
			VAR RangeEnd = FORMAT(Max('AXP Payment Program Detail'[CapturedOn])  ,"m/d/yyyy")
			Return
			"AXP Payment Program Detail " & CONCATENATE(CONCATENATE(RangeStart," - "),RangeEnd)
		isHidden
		lineageTag: 87254bde-174b-4a98-8f6f-5777f4ac7806

		changedProperty = IsHidden

