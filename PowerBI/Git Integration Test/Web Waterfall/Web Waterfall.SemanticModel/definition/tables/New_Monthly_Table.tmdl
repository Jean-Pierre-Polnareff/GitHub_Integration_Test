			"Payment in Full as % of $",(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Amod"),New_Monthly_Table[is_pay_in_full_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			
			"Installments $",(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),New_Monthly_Table[is_installment_submitted])),
