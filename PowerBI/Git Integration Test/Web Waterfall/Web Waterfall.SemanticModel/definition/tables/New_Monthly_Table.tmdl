	measure 'KMS PIN Login New test' = CALCULATE([Count_of_Rows],ALL('KMS New'[KPI],'KMS New'[Column1],'KMS New'[Parent KPI],'KMS New'[Parent KPI-Sort Order]),'KMS New'[KPI] IN { "pin_login_succeeded","dob_login_succeeded","ssn_login_succeeded","frictionless_login"}  )
		formatString: 0
		isHidden
		lineageTag: 5f760d2f-a3c3-4837-910f-7bbb10c9f09a

		changedProperty = IsHidden

	measure 'Main Measure' = ```
			
			VAR varKM = UPPER(IF(HASONEVALUE('KMS New'[KPI]),VALUES('KMS New'[KPI]),BLANK()))
			RETURN
			SWITCH(varKM,
			--==========================================Log in UX==================================================
			"Reference Number Entered",format(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"#,0"),
			"PIN Entered",format(CALCULATE([KMS PIN Entered New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"#,0"),
			"Successful Log In",format(CALCULATE([KMS PIN Login New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"#,0"),
			"Reference Number Locked",format(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reference_number_locked" ),"#,0"),
			"Reference Number Failed",format(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reference_number_login_failed" ),"#,0"),
			"Reference Number Succeeded",format(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reference_number_login_succeeded" ),"#,0"),
			"PIN Failed",format(CALCULATE([KMS PIN Entered New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "pin_login_failed" || 'New_Monthly_Table'[Key] = "ssn_login_failed" || 'New_Monthly_Table'[Key] ="dob_login_failed"),"#,0"),
			"Account Suppressed",format(CALCULATE([KMS PIN Entered New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "account_suppressed" ),"#,0"),
			"Log In Rate",format(CALCULATE([KMS Login % New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"0%;(0%)"),
			--========================================Performance================================================
			
			"Payments",format(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"#,0"),
			"Conversion Rate",format(CALCULATE([KMS Conversion %  New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <>"Nil")),"0%;(0%)"),
			
			"Payment $", 
			FORMAT( CALCULATE([KMS Payment $ New test],  KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),New_Monthly_Table[is_email]||New_Monthly_Table[is_sms]||New_Monthly_Table[is_unspecified]), "$#,##0" ),
			
			"Average Payment", 
			FORMAT( CALCULATE([KMS Average Payment New test],  KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month]<> "Nil")), "$#,##0" ),
			
			"Future Payments Set Up", format(CALCULATE([KMS Future Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"#,0"),
			"Future Payment $ Set Up", format(CALCULATE([KMS Future Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"$#,##0"),
			
			--========================================Payment Programs================================================
			
			"Payments in Full",format(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "pay_in_full_submitted" ),"#,0"),
			"Payment in Full as % of Total",format(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "pay_in_full_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			"Installments",format(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "installment_submitted" ),"#,0"),
			"Installments as % of Total",format(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "installment_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			"Reocurring Payments",format(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reocurring_submitted" ),"#,0"),
			"Reocurring Payments as % of Total",format(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reocurring_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			"Settlements",format(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "settlement_submitted" ),"#,0"),
			"Settlements as % of Total",format(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "settlement_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			"One Time Payments",format(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "one_time_payment_submitted" ),"#,0"),
			"One Time Payments as % of Total",format(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "one_time_payment_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			
			"AXP Payment Programs",format(CALCULATE([KMS AXP Payment Programs # New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"#,0"),
			
			"AXP Payment Programs % of Total",
			format(DIVIDE(CALCULATE([KMS AXP Payment Programs # New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Amod")),
			CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),New_Monthly_Table[SourceSystem]="AMEX Latitude")),"0%;(0%)"),
			
			
			
			"Payments in Full $",format(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),New_Monthly_Table[is_pay_in_full_submitted]),"$#,##0"),
			"Payment in Full as % of $",format(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Amod"),New_Monthly_Table[is_pay_in_full_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			
			"Installments $",format(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),New_Monthly_Table[is_installment_submitted]),"$#,##0"),
			"Installments as % of $",format(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),New_Monthly_Table[is_installment_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			
			
			"Reocurring Payments $",format(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_recurring_submitted] ),"$#,##0"),
			"Reocurring Payments as % of $",format(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_recurring_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			
			"Settlements $",format(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_settlement_submitted]),"$#,##0"),
			"Settlements as % of $",format(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_settlement_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			
			
			"One Time Payments $",format(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_one_time_payment_submitted] ),"$#,##0"),
			"One Time Payments as % of $",format(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_one_time_payment_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),"0%;(0%)"),
			
			
			"AXP Payment Programs $",format(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_Axp_payment_programs]),"$#,##0"),
			"AXP Payment Programs % of $",format(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_Axp_payment_programs] ),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[SourceSystem] = "AMEX Latitude")),"0%;(0%)"),
			
			--==================================================Contact Information===============
			"Contact Information Updated",format(CALCULATE([KMS Contact Info New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "contact_information_updated" ),"#,0"),
			"Contact Information Removed",format(CALCULATE([KMS Contact Info New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "contact_information_removed" ),"#,0"),
			"Email Consent Provided",format(CALCULATE([KMS Contact Info New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "email_consent_provided" ),"#,0"),
			"Email Consent Removed",format(CALCULATE([KMS Contact Info New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "email_consent_removed" ),"#,0"),
			"SMS Consent Provided",format(CALCULATE([KMS Contact Info New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "sms_consent_provided" ),"#,0"),
			"SMS Consent Removed",format(CALCULATE([KMS Contact Info New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "sms_consent_removed" ),"#,0"),
			"Support Email Sent",format(CALCULATE([KMS Contact Info New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "support_email_sent" ),"#,0"),
			
			
			format(CALCULATE([Count_of_Rows],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")),"#,0")
			)
			```
