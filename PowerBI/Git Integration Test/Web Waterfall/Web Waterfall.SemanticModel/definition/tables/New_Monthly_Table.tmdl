	measure 'KMS PIN Entered New test' = CALCULATE([Count_of_Rows],ALL('KMS New'[KPI],'KMS New'[Column1],'KMS New'[Parent KPI],'KMS New'[Parent KPI-Sort Order]),'KMS New'[KPI]IN {"account_suppressed","pin_login_failed","pin_login_succeeded","dob_login_succeeded","ssn_login_succeeded","dob_login_failed","ssn_login_failed","frictionless_login"} )
		formatString: 0
		isHidden
