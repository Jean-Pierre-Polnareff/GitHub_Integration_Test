	measure 'NMT MoM%' = ```
			
			IF(
			    ISFILTERED('New_Monthly_Table'[CapturedOn]),
			    ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
			    VAR __PREV_MONTH =
			        CALCULATE(
			            [Main Measure Numeric],
			            DATEADD('New_Monthly_Table'[CapturedOn].[Date], -1, MONTH)
			        )
			    VAR __CURRENT_MONTH = [Main Measure Numeric]
			    RETURN
			        IF(
			            ISBLANK(__PREV_MONTH) || ISBLANK(__CURRENT_MONTH),
			            BLANK(),  
			            DIVIDE(__CURRENT_MONTH - __PREV_MONTH, __PREV_MONTH)
			        )
			)
			
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		isHidden
		lineageTag: 94741a77-d1c8-4b55-8b78-07db51d98351

		changedProperty = IsHidden

	measure 'NMT YoY%' = ```
			
			IF(
			    ISFILTERED('New_Monthly_Table'[CapturedOn]),
			    ERROR("Time intelligence quick measures can only be grouped or filtered by the Power BI-provided date hierarchy or primary date column."),
			    VAR PREV_YEAR =
			        CALCULATE(
			            [Main Measure Numeric],
			            DATEADD('New_Monthly_Table'[CapturedOn].[Date], -1, YEAR)
			        )
			    VAR CURRENT_YEAR = [Main Measure Numeric]
			    RETURN
			        IF(
			            ISBLANK(PREV_YEAR) || ISBLANK(CURRENT_YEAR),
			            BLANK(), 
			            DIVIDE(CURRENT_YEAR - PREV_YEAR, PREV_YEAR)
			        )
			)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		isHidden
		lineageTag: 9f620ce4-3a69-4f45-a823-9e579180e1af

		changedProperty = IsHidden

	measure 'Monthly Sessions Table Selected Year' =
			
			VAR singleselection = "Year " & SELECTEDVALUE('New_Monthly_Table'[CapturedOn].[Year])
			VAR currentyear = "Year " & year(today())
			RETURN
			----IF
			----(
			----[DefaultSelection]=[AllSelections] ,"Year not Selected",singleselection)
			"Monthly Table " & singleselection
		isHidden
		lineageTag: 674012c2-ba1a-4051-8ea9-2445706520c8

		changedProperty = IsHidden

	measure 'Daily Table Selected Month Year-NMT' = ```
			
			VAR SelectedMonth = SELECTEDVALUE('New_Monthly_Table'[Month-Year])
			VAR MaxCapturedDate = CALCULATE(
			    MAX('New_Monthly_Table'[CapturedOn]),
			    ALL('New_Monthly_Table') 
			)
			VAR MaxMonthYear = FORMAT(MaxCapturedDate, "MMM-yy")
			
			VAR FinalMonth = 
			    IF(
			        NOT ISBLANK(SelectedMonth),
			        SelectedMonth,
			        BLANK()
			    )
			
			RETURN
			IF(
			    ISBLANK(FinalMonth),
			    "Daily Table",
			    "Daily Table " & FinalMonth
			)
			
			
			```
		isHidden
		displayFolder: Daily Table
		lineageTag: 26691a08-fa5f-4c4a-9ab9-7966f010fc55

		changedProperty = IsHidden

	measure SelectedMonthYear = ```
			
			VAR SelectedMonth = SELECTEDVALUE('New_Monthly_Table'[Month-Year])
			VAR CurrentMonth = FORMAT(TODAY(), "MMM-yyyy")
			RETURN
			IF(
			    NOT ISBLANK(SelectedMonth),
			    SelectedMonth,
			    CurrentMonth
			)
			
			```
