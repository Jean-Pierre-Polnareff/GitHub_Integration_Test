			"Reocurring Payments as % of $",(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_recurring_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			
			"Settlements $",(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_settlement_submitted])),
			"Settlements as % of $",(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_settlement_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			
			
