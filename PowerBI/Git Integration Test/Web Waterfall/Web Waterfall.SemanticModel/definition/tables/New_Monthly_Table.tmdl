	measure 'Main Measure Numeric' = ```
			
			VAR varKM = UPPER(IF(HASONEVALUE('KMS New'[KPI]),VALUES('KMS New'[KPI]),BLANK()))
			RETURN
			SWITCH(varKM,
			--==========================================Log in UX==================================================
			"Reference Number Entered",(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			"PIN Entered",(CALCULATE([KMS PIN Entered New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			"Successful Log In",(CALCULATE([KMS PIN Login New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			"Reference Number Locked",(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reference_number_locked" )),
			"Reference Number Failed",(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reference_number_login_failed" )),
			"Reference Number Succeeded",(CALCULATE([KMS Hits New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reference_number_login_succeeded" )),
			"PIN Failed",(CALCULATE([KMS PIN Entered New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),  'New_Monthly_Table'[Key] = "pin_login_failed" || 'New_Monthly_Table'[Key] = "ssn_login_failed" || 'New_Monthly_Table'[Key] ="dob_login_failed" )),
			"Account Suppressed",(CALCULATE([KMS PIN Entered New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "account_suppressed" )),
			"Log In Rate",(CALCULATE([KMS Login % New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			--========================================Performance================================================
			
			"Payments",(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			"Conversion Rate",(CALCULATE([KMS Conversion %  New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <>"Nil"))),
			
			"Payment $", 
			( CALCULATE([KMS Payment $ New test],  KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"),New_Monthly_Table[is_email]||New_Monthly_Table[is_sms]||New_Monthly_Table[is_unspecified]) ),
			
			"Average Payment", 
			( CALCULATE([KMS Average Payment New test],  KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			
			"Future Payments Set Up", (CALCULATE([KMS Future Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			"Future Payment $ Set Up", (CALCULATE([KMS Future Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"))),
			
			--========================================Payment Programs================================================
			
			"Payments in Full",(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "pay_in_full_submitted" )),
			"Payment in Full as % of Total",(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "pay_in_full_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			"Installments",(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "installment_submitted" )),
			"Installments as % of Total",(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "installment_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			"Reocurring Payments",(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reocurring_submitted" )),
			"Reocurring Payments as % of Total",(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "reocurring_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			"Settlements",(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "settlement_submitted" )),
			"Settlements as % of Total",(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "settlement_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			"One Time Payments",(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "one_time_payment_submitted" )),
			"One Time Payments as % of Total",(DIVIDE(CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[Key] = "one_time_payment_submitted" ),CALCULATE([KMS Payments New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			
