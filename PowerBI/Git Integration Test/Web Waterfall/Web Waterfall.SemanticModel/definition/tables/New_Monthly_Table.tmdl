			"One Time Payments as % of $",(DIVIDE(CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil"), 'New_Monthly_Table'[is_one_time_payment_submitted]),CALCULATE([KMS Payment $ New test],KEEPFILTERS('New_Monthly_Table'[CapturedOn].[month] <> "Nil")))),
			
			
