	measure 'MTD Comparison for Days' = ```
			
			VAR MaxDate = MAX('Metrics Data'[CapturedOn])
			VAR MaxMonth = FORMAT(MaxDate, "MMMM")
			VAR MaxYear = YEAR(MaxDate)
			VAR MaxDay = FORMAT(MaxDate, "dd")
			VAR CurrentMonthStart = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			VAR IsCurrentMonthDataAvailable = MaxDate >= CurrentMonthStart
			
			RETURN  IF( IsCurrentMonthDataAvailable,IF(MaxDay = "01",  "MTD Comparison for day 01", "MTD Comparison for day 01 to day " & MaxDay), IF(MaxDay = "01", "MTD Comparison for " & MaxMonth & " " & MaxYear & " day 01", "MTD Comparison for " & MaxMonth & " " & MaxYear & " day 01 to day " & MaxDay))
			
			
			```
