	measure SumAndRatios =
			
			VAR varKM = UPPER(IF(HASONEVALUE(KM[KM]),VALUES(KM[KM]),BLANK()))
			RETURN
			SWITCH(varKM,"> Reference Number Entered (A)",format([KM Hits],"#,0"),
			"> PIN Entered",format([KM PIN Entered],"#,0"),
			"Login Rate (B/A)",format([KM Login %],"0%;(0%)"),
			"> Payments (C)",format([KM Payments],"#,0"),
			"Conversion Rate (C/B)",format([KM Conversion %],"0%;(0%)"),
			"Payment $",format([KM Payment $],"$#,##0"),
			"Average Payment",format([KM Average Payment],"$#,##0"),
			"> Payment Method",format([KM Payment Method],"#,0"),
			"> Contact Info",format([KM Contact Info],"#,0"),
			"> Other",format([KM Other],"#,0"),
			
			"pin_login_succeeded (B)",format([KM PIN Login],"#,0"),
			
			">>prim_login_succeeded",format([KM PIN Prim],"#,0"),
			">>comaker_login_succeeded",format([KM PIN Comaker],"#,0"),
			
			format([RegularSum],"#,0"))
		isHidden
		lineageTag: d2a17b3b-06a2-4028-b845-a995f8395280

