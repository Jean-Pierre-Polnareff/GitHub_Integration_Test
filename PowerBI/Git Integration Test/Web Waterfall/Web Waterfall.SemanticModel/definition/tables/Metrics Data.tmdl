	measure 'Client Summary Hits' =
			
			VAR varKM11 = UPPER(IF(HASONEVALUE(KM[Month]),VALUES(KM[Month]),BLANK()))
			VAR CurrentMTDHits = CALCULATE([Current MTD Hits],ALL(KM[Month],KM[KM]))
			VAR PreviousMTDHits = CALCULATE([Previous MTD Hits],ALL(KM[Month],KM[KM]))
			----VAR MTDHitsBW = CALCULATE([# B/(W) Hits],ALL(KM[KM],KM[Column1]))
			VAR MTDHitsDifferencePercentage = CALCULATE([% B/(W) Hits],ALL(KM[Month],KM[KM]))
			VAR Currentmmmm=format(today()-1,"mmmm")
			VAR Previousmmmm = format(Month((Today()-1)-1),"mmmm")
			VAR Pctdiffmmmm =  "Percent diff from " & format(Month((Today()-1)-1),"mmmm")
			RETURN
			SWITCH(varKM11,
			Currentmmmm,
			format(
			CurrentMTDHits,
			"#,0"),
			
			Previousmmmm,
			format(
			PreviousMTDHits
			,"#,0")
			,
			----"# Diff from Previous",format(MTDHitsBW,"0%;(0%)"),
			Pctdiffmmmm,
			format(
			MTDHitsDifferencePercentage
			,"0%;(0%)")
			)
		isHidden
		lineageTag: c1a6df1c-4b25-4925-a991-3cd2c6ab8c4c

