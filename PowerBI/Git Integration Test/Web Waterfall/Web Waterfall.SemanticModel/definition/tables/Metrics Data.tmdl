	measure 'Weekday Conditional Formatting' = ```
			
			
			--VAR selectedmonth =ALLSELECTED('Metrics Data'[CapturedOn].[Month])
			VAR selectedmonthyear = ALLSELECTED('Metrics Data'[Month-Year])
			return
			
			IF(
			[DefaultSelection]=[AllSelections] ,
			
			CALCULATE(sum('Metrics Data'[weekdayc]),
			FILTER('Metrics Data','Metrics Data'[Month-Year]=FORMAT(today()-1,"MMM-YY"))),
			--FILTER('Metrics Data',month('metrics data'[capturedon])=month(today()))),
			
			CALCULATE(SUM('Metrics Data'[IsWeekDay]),
			FILTER('Metrics Data','Metrics Data'[Month-Year]=selectedmonthyear)))
			--FILTER('Metrics Data','metrics data'[capturedon].[month]=selectedmonth)))
			
			```
		formatString: 0
		isHidden
		lineageTag: cc0dbce6-7942-4d72-bd03-1b165c6ab74a

