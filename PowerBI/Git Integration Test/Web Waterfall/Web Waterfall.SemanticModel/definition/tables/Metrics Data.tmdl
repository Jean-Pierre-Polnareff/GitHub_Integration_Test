			"Payment $",format(CALCULATE([KM Payment $],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "January")),"$#,##0"),
			"Average Payment",format(CALCULATE([KM Average Payment],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "January")),"$#,##0"),
