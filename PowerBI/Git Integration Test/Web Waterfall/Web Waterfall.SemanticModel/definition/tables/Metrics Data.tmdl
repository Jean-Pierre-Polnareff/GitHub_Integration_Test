			"> PIN Entered",format(CALCULATE([KM PIN Entered],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			"Login Rate (B/A)",format(CALCULATE([KM Login %],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"0%;(0%)"),
			"> Payments (C)",format(CALCULATE([KM Payments],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			"Conversion Rate (C/B)",format(CALCULATE([KM Conversion %],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"0%;(0%)"),
			"Payment $",format(CALCULATE([KM Payment $],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"$#,##0"),
			"Average Payment",format(CALCULATE([KM Average Payment],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"$#,##0"),
			"> Payment Method",format(CALCULATE([KM Payment Method],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			"> Contact Info",format(CALCULATE([KM Contact Info],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			"> Other",format(CALCULATE([KM Other],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			
			"pin_login_succeeded (B)",format(CALCULATE([KM PIN Login],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			">>prim_login_succeeded",format(CALCULATE([KM PIN Prim],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			">>comaker_login_succeeded",format(CALCULATE([KM PIN Comaker],KEEPFILTERS('Metrics Data'[CapturedOn].[month] = "December")),"#,0"),
			
			
