	column IsMonth = ```
			var currentrowmonth = MONTH('Metrics Data'[CapturedOn])
			var ismonth = MONTH(now()-1)
			var prevmonth = if(MONTH(now()-1) - 1 = 0 ,12,MONTH(now()-1) - 1)
			
			
			return 
			
			IF(ismonth=currentrowmonth || prevmonth= currentrowmonth, "Yes",  "No")
			```
		isHidden
		lineageTag: 9fa973a8-5dab-4778-b73c-2e6c96f635dc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsDay = ```
			
			var Currentday = DAY(NOW()-1)
			var EOMonth = DAY(format(EOMONTH(NOW(),-1),"mm/dd/yyyy"))
			var EOMonthp = DAY(format(EOMONTH(NOW(),-2),"mm/dd/yyyy"))
			var greaterEOM = IF(EOMonth < EOMonthp ,EOMonthp,EOMonth)
			var dday = IF(DAY(NOW()) = 1 ,greaterEOM,currentday)
			var Currentrowday = DAY('Metrics Data'[CapturedOn])
			RETURN 
			IF('Metrics Data'[IsMonth]="Yes" && Currentrowday IN GENERATESERIES(1,dday,1),"Yes", "No")
			
			```
		isHidden
		lineageTag: 129a7932-0133-45b6-a582-e3a2994d6692
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsWeekDay = ```
			var Dayoftheweek = WEEKDAY('Metrics Data'[CapturedOn])
			VAR Allselections = COUNTROWS(DISTINCT(ALL('Metrics Data'[CapturedOn].[Month])))
			VAR DefaultSelection = COUNTROWS(DISTINCT(ALLSELECTED('Metrics Data'[CapturedOn].[Month])))
			VAR Dayoftheweek2=IF(WEEKDAY('Metrics Data'[CapturedOn])=1 || WEEKDAY('Metrics Data'[CapturedOn])=7 ,0,1)
			VAR DefaultDayofWeek = If(month('metrics data'[capturedon])=month(today()) && (WEEKDAY('Metrics Data'[CapturedOn])=1 || WEEKDAY('Metrics Data'[CapturedOn])=7) ,0,1)
			VAR currentmonth = If(month('metrics data'[capturedon])=month(today()),1,0)
			return
			 
			IF(Dayoftheweek = 1 || Dayoftheweek = 7,0,1)
			--IF(currentmonth=1 ,  DefaultDayofWeek,Dayoftheweek2)
			```
		isHidden
		formatString: 0
		lineageTag: f58b1f82-59dc-4fc3-a6d4-b38d7d18ffe5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column WeekDayC =
			VAR currentmonth = If(month('metrics data'[capturedon])=month(today()-1),1,0)
			RETURN
			
			IF(currentmonth=1,'Metrics Data'[IsWeekDay],0)
			--month('Metrics Data'[CapturedOn]) & " " & day('Metrics Data'[CapturedOn])
		isHidden
		formatString: 0
		lineageTag: fe15a755-e715-406f-8a5a-08152cc747fe
		summarizeBy: sum

