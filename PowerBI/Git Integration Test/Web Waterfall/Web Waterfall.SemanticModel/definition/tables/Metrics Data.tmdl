				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),DIVIDE(CALCULATE([KM Payment $]),CALCULATE([RegularSumSelection],ALL(KM[KM],KM[Column1]),KM[KM]="one_time_payment_submitted" || KM[KM]="pay_in_full_submitted" || KM[KM]="settlement_submitted" || KM[KM]="installment_submitted" || KM[KM]="custom_installment_submitted"  || KM[KM]="reocurring_submitted")))
			VAR KMPAYMENTMETHOD = AVERAGEX(
				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),CALCULATE([RegularSumSelection],ALL(KM[KM],KM[Column1]),KM[KM]="checking_account_used" || KM[KM]="debit_card_used" || KM[KM]="credit_card_used"))
			VAR KMCONTACTINFO = AVERAGEX(
				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),CALCULATE([RegularSumSelection],ALL(KM[KM],KM[Column1]),KM[KM]="contact_information_updated" || KM[KM]="email_consent_provided" || KM[KM]="sms_consent_provided"))
			VAR KMOTHER = AVERAGEX(
				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),CALCULATE([RegularSumSelection],ALL(KM[KM],KM[Column1]),KM[KM]="oos_disclosure_accepted" || KM[KM]="oos_disclosure_skipped" || KM[KM]="state_disclosure_accepted" || KM[KM]="support_email_sent"))
			
			VAR KMPINLOGIN = AVERAGEX(
				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),CALCULATE([RegularSumSelection],ALL(KM[KM],KM[Column1]),KM[KM]="pin_login_succeeded" || KM[KM]="dob_login_succeeded"  || KM[KM]="ssn_login_succeeded"  || KM[KM]="alt_pin_login_succeeded"  || KM[KM]="frictionless_login"  || KM[KM]="zip_login_succeeded"  ))
			
			VAR KMPINLOGINPRIM = AVERAGEX(
				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),CALCULATE([RegularSumSelection],ALL(KM[KM],KM[Column1]),KM[KM]="prim_login_succeeded"  ))
			
			VAR KMPINLOGINCOMAKER = AVERAGEX(
				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),CALCULATE([RegularSumSelection],ALL(KM[KM],KM[Column1]),KM[KM]="comaker_login_succeeded"  ))
			
			RETURN
			SWITCH(varAvg,"> Reference Number Entered (A)",FORMAT(KMHITS,"#,0"),
			"> PIN Entered",FORMAT(KMPINENTERED,"#,0"),
			"Login Rate (B/A)",FORMAT(KMLOGIN,"0%;(0%)"),
			"> Payments (C)",FORMAT(KMPAYMENTS,"#,0"),
			"Conversion Rate (C/B)",FORMAT(KMCONVERSION,"0%;(0%)"),
			"Payment $",FORMAT(KMPAYMENT,"$#,##0"),
			"Average Payment",FORMAT(KMAVERAGEPAYMENT,"$#,##0"),
			"> Payment Method",FORMAT(KMPAYMENTMETHOD,"#,0"),
			"> Contact Info",FORMAT(KMCONTACTINFO,"#,0"),
			"> Other",FORMAT(KMOTHER,"#,0"),
			
			"pin_login_succeeded (B)",FORMAT(KMPINLOGIN,"#,0"),
			">>prim_login_succeeded",FORMAT(KMPINLOGINPRIM,"#,0"),
			">>comaker_login_succeeded",FORMAT(KMPINLOGINCOMAKER,"#,0"),
			
			FORMAT(AVERAGEX(
				KEEPFILTERS(VALUES('Metrics Data'[CapturedOn].[Day])),
				CALCULATE([RegularSumSelection])),"#,0"))
