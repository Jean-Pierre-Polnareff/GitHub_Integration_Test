			VAR KMPAYMENTS = CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="one_time_payment_submitted" || KM[KM]="pay_in_full_submitted" || KM[KM]="settlement_submitted" || KM[KM]= "installment_submitted" || KM[KM]="custom_installment_submitted"  || KM[KM]="reocurring_submitted")
			VAR KMCONVERSION = Divide(CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="one_time_payment_submitted" || KM[KM]="pay_in_full_submitted" || KM[KM]="settlement_submitted" || KM[KM]="installment_submitted" || KM[KM]="custom_installment_submitted"  || KM[KM]="reocurring_submitted"),CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="pin_login_succeeded" || KM[KM]="dob_login_succeeded"  || KM[KM]="ssn_login_succeeded"  || KM[KM]="alt_pin_login_succeeded"  || KM[KM]="frictionless_login"  || KM[KM]="zip_login_succeeded"  ))
			VAR KMPAYMENT = CALCULATE([Payment $ D],ALL(KM[KM],KM[Column1]))
			VAR KMAVERAGEPAYMENT = DIVIDE(CALCULATE([Payment $ D],ALL(KM[KM],KM[Column1])),CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="one_time_payment_submitted" || KM[KM]="pay_in_full_submitted" || KM[KM]="settlement_submitted" || KM[KM]="installment_submitted" || KM[KM]="custom_installment_submitted"  || KM[KM]="reocurring_submitted"))
			VAR KMPAYMENTMETHOD = CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="checking_account_used" || KM[KM]="debit_card_used" || KM[KM]="credit_card_used")
			VAR KMCONTACTINFO = CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="contact_information_updated" || KM[KM]="email_consent_provided" || KM[KM]="sms_consent_provided")
			VAR KMOTHER = CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="oos_disclosure_accepted" || KM[KM]="oos_disclosure_skipped" || KM[KM]="state_disclosure_accepted" || KM[KM]="support_email_sent")
			VAR PINLOGIN = CALCULATE([RegularSumDefault],ALL(KM[KM],KM[Column1]),KM[KM]="pin_login_succeeded"  || KM[KM]="dob_login_succeeded"  || KM[KM]="ssn_login_succeeded"  || KM[KM]="alt_pin_login_succeeded"  || KM[KM]="frictionless_login"  || KM[KM]="zip_login_succeeded"  )
