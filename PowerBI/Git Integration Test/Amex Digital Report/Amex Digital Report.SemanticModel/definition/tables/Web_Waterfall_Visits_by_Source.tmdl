table Web_Waterfall_Visits_by_Source
	isHidden
	lineageTag: 134740a0-a666-426d-a969-126c2c9dadc6

	measure Email =
			
			VAR Email_Pay =
			CALCULATE(
			    SUM(Web_Waterfall_Visits_by_Source[Payments]),
			    Web_Waterfall_Visits_by_Source[Campaign] = "Email"
			)
			RETURN
			DIVIDE(Email_Pay,1000)
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		isHidden
		lineageTag: 331cb034-5095-445c-afde-9a2a4c738625

		changedProperty = IsHidden

	measure Portal = ```
			
