table 'Sharepoint - Amex ClientIDs Inclusion List'
	lineageTag: 05180148-3a23-4924-a7f0-06404fefd30d

	measure CommaSeparatedList =
			"**Client IDs included into data: " &
			CONCATENATEX (
			    VALUES ( 'Sharepoint - Amex ClientIDs Inclusion List'[LP] ),  -- Get distinct values
			    'Sharepoint - Amex ClientIDs Inclusion List'[LP],             -- Column to concatenate
			    ", ",                            -- Separator
			    'Sharepoint - Amex ClientIDs Inclusion List'[LP],              -- Optional: Order by column
			    ASC
			)
			& "."
		lineageTag: 45003122-da65-4d84-8235-b6d98a3d8213

	column LP
		dataType: string
		lineageTag: 505c4621-fd61-4305-8aca-b7acab60e472
		summarizeBy: none
		sourceColumn: LP

		annotation SummarizationSetBy = Automatic

	column Segment
