		source =
				let
				    Source = SharePoint.Contents("https://radiusgs.sharepoint.com/sites/analytics/", [ApiVersion = 15]),
				    #"Shared Documents" = Source{[Name="Shared Documents"]}[Content],
				    projects = #"Shared Documents"{[Name="projects"]}[Content],
				    reporting = projects{[Name="reporting"]}[Content],
				    #"Amex Digital Report" = reporting{[Name="Amex Digital Report"]}[Content],
				    #"Amex Client Codes to be included into Amex Digital report xlsx" = #"Amex Digital Report"{[Name="Amex Client Codes to be included into Amex Digital report.xlsx"]}[Content],
				    #"Imported Excel Workbook" = Excel.Workbook(#"Amex Client Codes to be included into Amex Digital report xlsx"),
				    Table1_Table = #"Imported Excel Workbook"{[Item="Table1",Kind="Table"]}[Data]
				in
