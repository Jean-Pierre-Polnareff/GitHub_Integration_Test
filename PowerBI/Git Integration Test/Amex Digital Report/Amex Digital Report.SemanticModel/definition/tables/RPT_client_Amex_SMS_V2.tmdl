table RPT_client_Amex_SMS_V2
	isHidden
	lineageTag: df9f0a16-d7bf-475d-b1e7-9130cf8f7ef9

	measure 'Connect %' = Calculate(DIVIDE(SUM(RPT_client_Amex_SMS_V2[call_connects]), SUM(RPT_client_Amex_SMS_V2[sms_delivered])))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		isHidden
		lineageTag: 2f4fa705-9cc3-466d-aa00-9430847e3509

	measure 'Conversion % (SMS)' = CALCULATE(DIVIDE(SUM(RPT_client_Amex_SMS_V2[conversions]), SUM(RPT_client_Amex_SMS_V2[call_rpcs])))
		formatString: 0\ %;-0\ %;0\ %
		isHidden
		lineageTag: 59726fc0-7638-40a2-9bd3-0bfc028de76a

	measure 'Delivered %' = Calculate(DIVIDE(SUM(RPT_client_Amex_SMS_V2[sms_delivered]), SUM(RPT_client_Amex_SMS_V2[sms_delivered]) + SUM(RPT_client_Amex_SMS_V2[sms_failed])))
		formatString: 0\ %;-0\ %;0\ %
		isHidden
		lineageTag: 661f4d13-67d8-4e6a-ab2c-9bb6e165aa31

	measure 'Failed %' = Calculate(DIVIDE(SUM(RPT_client_Amex_SMS_V2[sms_failed]), SUM(RPT_client_Amex_SMS_V2[sms_delivered]) + SUM(RPT_client_Amex_SMS_V2[sms_failed])))
		formatString: 0\ %;-0\ %;0\ %
		isHidden
		lineageTag: aa6cb194-a1ef-4820-9b90-70873df50db0

	measure 'Opt Out %' = CALCULATE(DIVIDE(SUM(RPT_client_Amex_SMS_V2[sms_stopped]), SUM(RPT_client_Amex_SMS_V2[sms_delivered])))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		isHidden
		lineageTag: 8f9902a1-5ccf-4816-8886-8e397c9e7a3e

	measure 'Promise %' = Calculate(DIVIDE(SUM(RPT_client_Amex_SMS_V2[call_promises]), SUM(RPT_client_Amex_SMS_V2[call_rpcs])))
		formatString: 0\ %;-0\ %;0\ %
		isHidden
		lineageTag: 2014d109-e143-4e08-8862-96ea391740c7

	measure 'RPC %' = CALCULATE(DIVIDE(SUM(RPT_client_Amex_SMS_V2[call_rpcs]), SUM(RPT_client_Amex_SMS_V2[call_connects])))
		formatString: 0\ %;-0\ %;0\ %
		isHidden
		lineageTag: 5a11eb62-30e3-4338-9c2e-076f2575a1f5

	measure Sent = CALCULATE(SUM(RPT_client_Amex_SMS_V2[sms_failed]) + SUM(RPT_client_Amex_SMS_V2[sms_delivered]))
		formatString: #,0
		isHidden
		lineageTag: 8c0f9520-5a83-45a5-b214-df96abb13822

