	measure 'Scrub Rate' =
			
			VAR invalidemailscrubbed = Calculate(sum(EmailRPT_MonthClientLetter[invalid_email_scrubbed]))
			VAR optoutscrubbed = CALCULATE(SUM(EmailRPT_MonthClientLetter[optout_scrubbed]))
			VAR whitelistscrubbed = CALCULATE(SUM(EmailRPT_MonthClientLetter[whitelist_scrubbed]))
			VAR requested = CALCULATE(SUM(EmailRPT_MonthClientLetter[requested]))
			RETURN
			CALCULATE((invalidemailscrubbed + optoutscrubbed + whitelistscrubbed)/requested)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		isHidden
		lineageTag: b047fa11-260c-4aec-955b-ede75d6faa97

	measure TopN+Others = ```
			
			VAR ClientbySent = RANKX(ALL(EmailRPT_MonthClientLetter[client]),calculate(SUM(EmailRPT_MonthClientLetter[sent])),,DESC,Dense)
			RETURN
			IF(ClientbySent <= 'Select Top N Clients'[Select Top N Clients Value] , calculate(SUM(EmailRPT_MonthClientLetter[sent])), BLANK())
			
			```
		formatString: 0
		isHidden
