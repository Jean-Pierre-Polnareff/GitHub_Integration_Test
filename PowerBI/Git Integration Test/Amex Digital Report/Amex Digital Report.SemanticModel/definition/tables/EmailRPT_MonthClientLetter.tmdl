	measure 'IsAverage 100 sends per month' =
			
			VAR countofmonths = CALCULATE(DISTINCTCOUNT(EmailRPT_MonthClientLetter[Month-Year]))
			VAR NumberofSends = CALCULATE(SUM(EmailRPT_MonthClientLetter[sent]))
			RETURN
			IF(CALCULATE(DIVIDE(NumberofSends,countofmonths ), ALLEXCEPT(EmailRPT_MonthClientLetter,EmailRPT_MonthClientLetter[LTR])) >= 100 , "Yes","No")
		isHidden
		lineageTag: 1fa89cf1-4f26-460e-ab6b-6e59e58e594d

