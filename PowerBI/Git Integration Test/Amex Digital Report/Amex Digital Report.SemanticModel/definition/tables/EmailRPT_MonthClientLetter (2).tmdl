	isHidden
	lineageTag: 50c274e7-79b9-4c8d-92df-e9f7f94154e2

	measure 'Open %' = CALCULATE(DIVIDE(sum('EmailRPT_MonthClientLetter (2)'[Opened]), SUM('EmailRPT_MonthClientLetter (2)'[Delivered])))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		isHidden
		lineageTag: 0d122049-43b4-4fc8-95de-ac36694813b8

	measure 'Click %' = CALCULATE(DIVIDE(sum('EmailRPT_MonthClientLetter (2)'[clicks]), SUM('EmailRPT_MonthClientLetter (2)'[Opened])))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		isHidden
		lineageTag: 4a9fcbf7-8105-4e12-8e1e-5b675a91298e

	measure 'End of Date Range' =
			
			---VAR PrevEOM = EOMONTH(TODAY() ,-1)
			VAR StartDate = MIN('EmailRPT_MonthClientLetter (2)'[Month Date])
			---VAR stndrdth = IF(DAY(PrevEOM ) = 31 , "st", "th")
			VAR EndDate = EOMONTH(MAX('EmailRPT_MonthClientLetter (2)'[Month Date]),0)
			Return
			"Date Range: " & StartDate & " to " & EndDate & ".
			Threshold for Top Calculation: Average 100 emails sent per month."
		isHidden
		lineageTag: 398be380-0da3-4828-8b4a-78567cdb7fb5

	measure 'Sends Per Month per LTR' =
			
			VAR SelectedMonths = CALCULATETABLE(VALUES('EmailRPT_MonthClientLetter (2)'[Month Date]), ALLSELECTED('EmailRPT_MonthClientLetter (2)'[Month Date]))
			VAR No_of_Months = COUNTROWS(SelectedMonths)
			RETURN
			DIVIDE(
			CALCULATE(
			SUM('EmailRPT_MonthClientLetter (2)'[sent]),
			ALLEXCEPT('EmailRPT_MonthClientLetter (2)', 'EmailRPT_MonthClientLetter (2)'[LTR], 'EmailRPT_MonthClientLetter (2)'[clientid]), 'EmailRPT_MonthClientLetter (2)'[Month Date] IN SelectedMonths
			)
			, No_of_Months
			)
		formatString: #,0
		isHidden
		lineageTag: 9ea67ee2-1046-4de7-a6e9-a2902d7b9bcd

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Sends Per Month with Min 100 Sends' = ```
			
			VAR LTRsToSendMonths =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'EmailRPT_MonthClientLetter (2)',
			            'EmailRPT_MonthClientLetter (2)'[LTR],
			            'EmailRPT_MonthClientLetter (2)'[Month Date]
			        ),
			        "SendsPerMonth",
			        CALCULATE(
			            SUM('EmailRPT_MonthClientLetter (2)'[sent]),
			            ALLEXCEPT('EmailRPT_MonthClientLetter (2)', 'EmailRPT_MonthClientLetter (2)'[LTR]),
			            'EmailRPT_MonthClientLetter (2)'[Month Date] IN VALUES('EmailRPT_MonthClientLetter (2)'[Month Date])
			        )
			    )
			RETURN
			CALCULATE(
			    MAXX(
			        FILTER(
			            TOPN(3, LTRsToSendMonths, [SendsPerMonth], DESC),
			            [SendsPerMonth] >= 100
			        ),
			        [SendsPerMonth]
			    ),
			    ALLEXCEPT('EmailRPT_MonthClientLetter (2)', 'EmailRPT_MonthClientLetter (2)'[LTR])
			)
			
			```
		isHidden
		lineageTag: 3b6a4ba4-12b4-4bcf-a642-cb10019c7525

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Click% with Sends Per Month with Min 100 Sends' = ```
			
			VAR SelectedMonths = CALCULATETABLE(VALUES('EmailRPT_MonthClientLetter (2)'[Month Date]), ALLSELECTED('EmailRPT_MonthClientLetter (2)'[Month Date]))
			VAR No_of_Months = COUNTROWS(SelectedMonths)
			VAR LTRsToSendMonths =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'EmailRPT_MonthClientLetter (2)',
			            'EmailRPT_MonthClientLetter (2)'[LTR]
			            --,'EmailRPT_MonthClientLetter (2)'[Month Date]
			        ),
			        "SendsPerMonth",
			        DIVIDE(
			        CALCULATE(
			            SUM('EmailRPT_MonthClientLetter (2)'[sent]),
			            ALLEXCEPT('EmailRPT_MonthClientLetter (2)', 'EmailRPT_MonthClientLetter (2)'[LTR], 'EmailRPT_MonthClientLetter (2)'[clientid]), 'EmailRPT_MonthClientLetter (2)'[Month Date] IN SelectedMonths
			        )
			        , No_of_Months
			        )
			        ,
			        "ClickRate",
			        [Click %]
			
			    )
			RETURN
			CALCULATE(
			    MAXX(
			        FILTER(
			            TOPN(3, LTRsToSendMonths, [ClickRate], DESC),
			            [SendsPerMonth] >= 100
			        ),
			        [ClickRate]
			    ),
			    ALLEXCEPT('EmailRPT_MonthClientLetter (2)', 'EmailRPT_MonthClientLetter (2)'[LTR]) 
			)
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
