	partition DimCustomerProduct-9d2b85ef-351c-46f6-9f44-dcb95feb26a5 = m
		mode: import
		source =
				let
				    Source = Sql.Database("DFW2-BISQL-001", "DW_MSTR_DM", [Query="SELECT #(lf)   CAST(a.CustomerId AS VARCHAR (10)) AS CustomerId#(lf)  , CASE WHEN a.KeySourceSystem = 1 THEN 'MedProd Artiva'#(lf)  WHEN a.KeySourceSystem = 2 THEN 'ThirdProd Artiva'#(lf)  WHEN a.KeySourceSystem = 3 THEN 'AMEX Latitude'#(lf)  WHEN a.KeySourceSystem = 4 THEN 'FACS'#(lf)  ELSE 'Unknown' #(lf)  END AS SourceSystem#(lf)  ,a.Clientid#(lf)  ,a.ProductType#(lf)  ,b.Product#(lf)  FROM [DW_MSTR_DM].[dbo].[DimCustomerProduct] (NOLOCK) a#(lf)  LEFT JOIN#(lf)  [CLIENT_ANALYTICS].[dbo].[RPT_Amex_ProductType-Product_Mapping] (NOLOCK) b#(lf)  ON a.ProductType = b.ProductType"])
				in
				    Source

