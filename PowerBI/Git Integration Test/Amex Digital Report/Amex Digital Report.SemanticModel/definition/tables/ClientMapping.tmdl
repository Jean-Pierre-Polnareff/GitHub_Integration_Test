	partition ClientMapping-eb276a06-36be-4e77-82c6-c3ba94177311 = m
		mode: import
		source =
				let
				    Source = Sql.Database("DFW2-BISQL-001", "DW_MSTR_DM", [Query=" SELECT DISTINCT d.[ClientId]#(lf)               , CASE WHEN d.SourceSystem='AMEX Latitude' THEN ISNULL(a.amex_segment_Group,'Amex - Other')#(lf)#(tab)#(tab)#(tab)#(tab)       ELSE d.ClientParent#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)   END AS ClientParent#(lf)#(tab)#(tab)#(tab)#(tab), d.[ClientStreamId]#(lf)#(tab)#(tab)#(tab)#(tab), d.[ClientStream]#(lf)#(tab)#(tab)#(tab)#(tab), CASE WHEN d.SourceSystem = 'MEDPROD' THEN 'Medprod Artiva'#(lf)#(tab)#(tab)#(tab)#(tab)       WHEN d.SourceSystem = 'THIRDPROD' THEN 'Thirdprod Artiva'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)   ELSE d.SourceSystem#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)   END AS SourceSystem#(lf)FROM [DW_MSTR_DM].[dbo].[DimClient] d (NOLOCK)#(lf)         LEFT JOIN#(lf)     CLIENT_ANALYTICS.dbo.vw_Amex_ClientCodes_LookupTable a ON d.ClientId=a.clientcode#(lf)#(tab)#(lf)WHERE LEN(d.ClientId)>0 AND d.ClientId IS NOT null#(lf)#(lf)UNION #(lf)SELECT DISTINCT [Client_ID] AS ClientId#(lf)                , [Parent] AS ClientParent#(lf)#(tab)#(tab)#(tab)#(tab), CONVERT( VARCHAR(50), [Client_Stream_ID]) AS ClientStreamId#(lf)#(tab)#(tab)#(tab)#(tab), [Client_Stream] AS ClientStream#(lf)#(tab)#(tab)#(tab)#(tab), [SourceSystem] = 'FACS'#(lf)FROM [DW_MSTR_DM].[dbo].[TblClientStreams] (NOLOCK)#(lf)WHERE LEN(client_id)>0 AND client_id IS NOT null"])
				in
				    Source

