	measure Hits = CALCULATE(SUM('Metrics Data'[Count]),ALL('Metrics Data'[Key (groups)]),'Metrics Data'[Key (groups)]="Reference Number Entered (A)" || 'Metrics Data'[Key]="frictionless_login" || 'Metrics Data'[Key]="Spanish_portal_login" )
