	measure 'Average Payment' =
			
			VAR No_of_Payments = CALCULATE(SUM('Metrics Data'[Count]),ALL('Metrics Data'[Key (groups)]),'Metrics Data'[Key (groups)]="Payment Method")
			VAR Payment_dollars = CALCULATE(SUM('Metrics Data'[Payments]))
			RETURN
			CALCULATE(DIVIDE(Payment_dollars,No_of_Payments))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2701e980-33d8-4499-902d-5c3b56ac81e2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

